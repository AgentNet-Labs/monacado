# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js
/.next/
/out/
next-env.d.ts

# Production build
/build

# Generated (derived) artifacts — regenerate with `npm run contracts:export`
/generated/

# Testing / coverage
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/

# Vercel CLI link state and pulled environment files. `vercel link` also appends
# a broad `.env*` here; it is deliberately not kept, because it sits after the
# `!.env.example` negation above and silently re-ignores the one env file this
# repository does track. The existing `.env` / `.env.*` / `!.env.example` block
# already covers everything `vercel env pull` writes.
.vercel

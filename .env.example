# Monacado — environment example (placeholders only; never put real secrets here).
#
# Copy to `.env` (which is git-ignored) and fill in local values.

# Product source-record persistence (Phase 0D).
# Local disposable MySQL only for development/tests — never a production,
# staging, or shared database. Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for a local disposable instance (no password, loopback):
DATABASE_URL="mysql://root@127.0.0.1:3306/monacado_dev"

# ---------------------------------------------------------------------------
# Registrar transport configuration (Phase 0E.6.2).
#
# PLACEHOLDERS ONLY. No real endpoint, Registrar identifier, or credential
# belongs in this file or anywhere else in the repository.
#
# Disabled by default: with MONACADO_REGISTRAR_ENABLED unset, nothing is sent
# and no credential is read. There are deliberately no production defaults.
#
# None of these are NEXT_PUBLIC_ — they must never reach a browser bundle.
# ---------------------------------------------------------------------------

# Master switch. Anything other than true/1/yes means disabled.
MONACADO_REGISTRAR_ENABLED="false"

# The Registrar's own identifier, as issued by that Registrar.
MONACADO_REGISTRAR_ID="an:registrar:REPLACE_ME"

# Absolute REGISTER endpoint. Must be https: and must match one allowed origin
# below exactly — no wildcards, no suffix matching.
MONACADO_REGISTRAR_ENDPOINT="https://registrar.example/v1/register"

# Comma-separated exact origins we may send to.
MONACADO_REGISTRAR_ALLOWED_ORIGINS="https://registrar.example"

# Optional bounds. Defaults: 10000 ms, 65536 bytes.
# MONACADO_REGISTRAR_TIMEOUT_MS="10000"
# MONACADO_REGISTRAR_MAX_RESPONSE_BYTES="65536"

# Only BEARER_ENV is implemented.
MONACADO_REGISTRAR_CREDENTIAL_MODE="BEARER_ENV"

# The NAME of the variable holding the bearer token — NOT the token itself.
# The configuration object stores this name and never the secret value.
MONACADO_REGISTRAR_BEARER_TOKEN_ENV="MONACADO_REGISTRAR_BEARER_TOKEN"

# The named secret itself. Leave UNSET here; supply it out of band (a secret
# manager, or a git-ignored .env that is never committed).
# MONACADO_REGISTRAR_BEARER_TOKEN=

# TEST ONLY. Permits plain http: to a loopback host so the local mock server can
# be used. Must remain false in any real deployment.
# MONACADO_REGISTRAR_ALLOW_LOOPBACK_HTTP="false"

# ---------------------------------------------------------------------------
# Publication worker command (Phase 0E.7.2) — `npm run worker:publication:once`.
#
# ONE command, ONE bounded cycle, then the process ends. There is no daemon, no
# scheduler, no cron, no sleep, and no automatic second cycle: running again is
# an external decision.
#
# Disabled by default. With MONACADO_PUBLICATION_WORKER_ENABLED unset the command
# emits a single DISABLED line, performs no database query and no secret read,
# and exits 0. There are deliberately NO defaults for the bounds below — an
# unconfigured deployment must publish nothing rather than guess.
#
# An enabled worker also requires the Registrar block above to be READY.
#
# Any MONACADO_PUBLICATION_WORKER_* variable not listed here is REFUSED, so a
# misspelled switch fails loudly instead of leaving the worker silently off.
#
# None of these are NEXT_PUBLIC_, and none of them holds a secret.
# See docs/PRODUCT_PUBLICATION_WORKER_ENTRYPOINT.md.
# ---------------------------------------------------------------------------

# Master switch. Anything other than true/1/yes means disabled.
MONACADO_PUBLICATION_WORKER_ENABLED="false"

# Maximum orchestration runs in the one cycle. Bounded 1..100 (Phase 0E.7.1).
MONACADO_PUBLICATION_WORKER_MAX_RUNS="5"

# How long a claimed outbox item stays leased. Bounded 1..86400 seconds.
MONACADO_PUBLICATION_WORKER_LEASE_SECONDS="3600"

# Fixed delay before a provably-undelivered retryable failure becomes eligible
# again. Bounded 1..86400 seconds. No jitter and no backoff curve in this phase.
MONACADO_PUBLICATION_WORKER_RETRY_DELAY_SECONDS="900"

# Optional one-time stale-claim recovery sweep at cycle start. When enabled, the
# limit is required. Bounded 1..1000.
# MONACADO_PUBLICATION_WORKER_RECOVERY_ENABLED="false"
# MONACADO_PUBLICATION_WORKER_RECOVERY_LIMIT="50"

# Monitoring output: JSON_LINES (default) or SILENT.
# MONACADO_PUBLICATION_WORKER_OUTPUT_MODE="JSON_LINES"

# Optional correlation id echoed on every emitted line. Generated when unset.
# Bounded, opaque characters only — it must carry no secret and no business data.
# MONACADO_PUBLICATION_WORKER_CYCLE_ID="local-once"

# ---------------------------------------------------------------------------
# Stripe test-mode payments (Phase 1.0) — executable buyer checkout.
#
# PLACEHOLDERS ONLY. No real key, signing secret, or account identifier belongs
# in this file or anywhere else in the repository. `.env` is git-ignored;
# supply real values there or from a secret manager.
#
# TEST MODE ONLY. `MONACADO_STRIPE_MODE` has exactly one permitted value, and
# `resolveStripeApiKey` refuses any key that is not `sk_test_`-prefixed — an
# `sk_live_` key is rejected outright rather than trusted because the mode label
# said TEST. Reaching live payments requires editing
# src/server/payments/stripe-runtime-config.ts in the open.
#
# Disabled by default: with MONACADO_STRIPE_ENABLED unset the checkout route
# answers 503 CHECKOUT_NOT_CONFIGURED, reads no credential, and contacts nobody.
#
# None of these are NEXT_PUBLIC_ — they must never reach a browser bundle. The
# buyer flow uses Stripe's HOSTED checkout page, so no publishable key is needed
# in the browser at all and none is configured here.
#
# See docs/EXECUTABLE_CHECKOUT_AND_STRIPE_TEST_MODE.md.
# ---------------------------------------------------------------------------

# Master switch. Anything other than true/1/yes means disabled.
MONACADO_STRIPE_ENABLED="false"

# The only permitted value in this phase.
MONACADO_STRIPE_MODE="TEST"

# The NAMES of the variables holding the credentials — NOT the credentials.
# The parsed configuration object stores these names and never the values.
MONACADO_STRIPE_API_KEY_ENV="MONACADO_STRIPE_SECRET_KEY"
MONACADO_STRIPE_WEBHOOK_SECRET_ENV="MONACADO_STRIPE_WEBHOOK_SECRET"

# The named secrets themselves. Leave UNSET here; supply them out of band.
#   MONACADO_STRIPE_SECRET_KEY      — a Stripe TEST secret key (sk_test_…)
#   MONACADO_STRIPE_WEBHOOK_SECRET  — the endpoint signing secret (whsec_…),
#                                     printed by `stripe listen` or shown once
#                                     in the Stripe dashboard.
# MONACADO_STRIPE_SECRET_KEY=
# MONACADO_STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the buyer. Both must be absolute; https: is required
# unless MONACADO_STRIPE_ALLOW_LOOPBACK_HTTP permits a loopback host. The route
# appends `?orderId=…`; the guest claim code is NEVER placed in a URL.
MONACADO_STRIPE_SUCCESS_URL="http://localhost:3000/checkout/result"
MONACADO_STRIPE_CANCEL_URL="http://localhost:3000/checkout/result"

# Countries Stripe may collect a SHIPPING address for. Comma-separated ISO
# 3166-1 alpha-2 codes.
#
# Stripe requires an explicit allow-list — there is no "anywhere" value — so this
# is a DEPLOYMENT DECISION, like the commercial and risk policies. It is never
# derived from what a buyer types: a list that widened itself to whatever a
# client supplied would be no list.
#
# Unset defaults to a deliberately NARROW starter set (US,CA,GB,IE,AU,NZ). A
# deployment that ships further widens it here; one that has not thought about it
# should not be silently offering worldwide delivery.
# MONACADO_STRIPE_SHIPPING_COUNTRIES="US,CA,GB,IE,AU,NZ"

# LOCAL ONLY. Permits plain http: return URLs to localhost/127.0.0.1/[::1].
# Must be false anywhere a real buyer can reach.
MONACADO_STRIPE_ALLOW_LOOPBACK_HTTP="true"

# ---------------------------------------------------------------------------
# Buyer-checkout configuration (Phase 1.0) — NOT Stripe's.
#
# Which Monacado commercial policy governs checkout is a Monacado decision and
# is deliberately filed apart from the payment provider. It is CONFIGURATION,
# never a request parameter: a client that could name the policy could name
# Monacado's retention rate.
# ---------------------------------------------------------------------------

# The stable id of a CommercialPolicy that has an ACTIVE version (Phase 0M.R1).
# Per-transaction / per-participant policy selection remains 0M.R2.
MONACADO_CHECKOUT_POLICY_ID="mon:cpol:REPLACEMEREPLACEMEREPLACE0"

# The exact origin this deployment answers on. Used to refuse a cross-site form
# post to /api/checkout. Scheme + host + optional port; no path, no wildcard.
MONACADO_APP_ORIGIN="http://localhost:3000"

# ---------------------------------------------------------------------------
# Transactional mail (Phase 1.1) — buyer and participant notice delivery.
#
# NO EMAIL VENDOR IS CONFIGURED OR INSTALLED. The repository identifies none,
# so this phase built the provider-neutral seam and two local adapters rather
# than choosing a third party, a data-processing relationship, and a
# deliverability story on Monacado's behalf. Adding SES, Postmark, or Resend
# later is a new adapter beside them and NO change to any caller.
#
# Disabled by default, and disabled is a FIRST-CLASS state: with
# MONACADO_MAIL_ENABLED unset every message is refused with the bounded code
# CHANNEL_NOT_CONFIGURED, and a NotificationDelivery row is still written
# recording the refusal. An unconfigured deployment therefore reports exactly
# how many notices it did not send, rather than silently sending nothing.
#
# DELIVERY IS SUPPLEMENTAL, NEVER CANONICAL. AUTHORITATIVE_STOREFRONT_SOURCE_
# MODEL.md §3a: the Monacado admin panel is the canonical channel and email
# "can never replace it". No delivery satisfies, closes, or advances a
# NotificationObligation.
#
# None of these are NEXT_PUBLIC_ and none holds a secret — there is no
# credential here because there is no vendor.
#
# See docs/ORDER_EXPIRY_AND_BUYER_NOTIFICATION_DELIVERY.md.
# ---------------------------------------------------------------------------

# Master switch. Anything other than true/1/yes means disabled.
MONACADO_MAIL_ENABLED="false"

# Which adapter to use when enabled. LOG writes a line with a REDACTED
# destination (a***@example.com) and never the body, then accepts. An
# unrecognised value refuses rather than falling back to something that
# silently accepts.
MONACADO_MAIL_TRANSPORT="LOG"

# ---------------------------------------------------------------------------
# Marketplace policy bootstrap and email verification (Phase 1.4).
#
# Phase 1.3 made an ACTIVE marketplace policy a prerequisite for participant
# activation and for every checkout, and shipped no way to create one. The
# operator path is:
#
#   npm run policy:bootstrap           # record the shipped version as DRAFT
#   npm run policy:bootstrap:activate  # record if needed, then ACTIVATE it
#   npm run policy:bootstrap:inspect   # read and report; write nothing
#
# PRODUCTION WRITES ARE GATED, NOT FORBIDDEN. A MUTATING run against a target
# classified production (NODE_ENV=production) additionally requires the argv
# flag --confirm-production, and refuses before any write without it. The
# confirmation is deliberately NOT an environment variable: a variable is set
# once and then silently authorises every later invocation.
#
# NODE_ENV only CLASSIFIES the target; it never authorises one. Nothing infers
# authorisation from DATABASE_URL, a CI variable, or a hostname.
#
# --inspect never mutates and never needs the confirmation.
#
# A PRODUCTION ACTIVATION NEEDS BOTH WORDS: policy:bootstrap:activate AND
# --confirm-production. Confirming a write never implies activating a policy.
#
# No production execution has occurred. Every run so far has been against the
# disposable local database.
#
# Verification email delivery goes through the SAME Phase 1.1 mail seam above.
# NO SEPARATE MAIL CONFIGURATION EXISTS AND NONE SHOULD BE ADDED: with
# MONACADO_MAIL_ENABLED unset, a verification message is refused with
# CHANNEL_NOT_CONFIGURED exactly like every other notice, and the challenge is
# still issued and still auditable.
#
# The verification link is built from MONACADO_APP_ORIGIN above — the origin
# this deployment already declares. It is NEVER derived from a request Host
# header: an origin taken from one turns every verification email into a link
# to whatever host asked for it.
# ---------------------------------------------------------------------------

# The internal Account id recorded as having recorded the policy version.
# REQUIRED by the bootstrap command; --recorded-by=<accountId> overrides it.
# An internal account id, never an email address. The account must exist — a
# governance row records WHO recorded a version, and a fabricated recorder is
# worse than an unrecorded one.
MONACADO_POLICY_BOOTSTRAP_ACCOUNT_ID=""

# ---------------------------------------------------------------------------
# Production transactional email and durable delivery (Phase 1.5).
#
# THE MAIL VENDOR IS NOW SELECTED: Postmark, behind the SAME provider-neutral
# MailPort declared in Phase 1.1. `postmark-mail-adapter.ts` is the only file in
# the repository that knows what Postmark is, and no caller above the port
# changed to accommodate it.
#
# NO PRODUCTION SEND HAS OCCURRED and NO REAL CREDENTIAL IS IN THIS REPOSITORY.
# Every test drives a capturing adapter or an injected fetch.
#
# FAIL CLOSED. Selecting POSTMARK with no token, no From address, or an
# unparseable From address REFUSES. It does not fall back to the log adapter: a
# deployment that believes it is sending production mail and is quietly writing
# to stdout is worse than one that refuses to start sending.
#
# The MAIL_ENABLED master switch above still governs everything. Disabled stays
# a first-class state and refuses with CHANNEL_NOT_CONFIGURED — which Phase 1.5
# classifies as TRANSIENT, so the commitment survives until an operator
# configures mail and only exhausting the bounded retry policy makes it terminal.
#
# Set MONACADO_MAIL_TRANSPORT="POSTMARK" to use it. LOG and CAPTURE remain.
#
# See docs/PRODUCTION_COMMUNICATIONS_AND_NOTIFICATION_DELIVERY.md.
# ---------------------------------------------------------------------------

# The NAME of the variable holding the Postmark server token — never the token.
# The same construction MONACADO_STRIPE_API_KEY_ENV uses, for the same reason:
# a credential that is never in the config object cannot leak from it.
MONACADO_POSTMARK_TOKEN_ENV="MONACADO_POSTMARK_SERVER_TOKEN"

# The token itself. NEVER COMMITTED. Left empty here on purpose.
MONACADO_POSTMARK_SERVER_TOKEN=""

# The verified sender. Postmark refuses anything else, which makes this a
# deployment fact rather than a preference — and never a request parameter: a
# caller that could name the From address could send as Monacado.
MONACADO_MAIL_FROM_ADDRESS="notifications@example.invalid"

# Which Postmark message stream. Transactional mail belongs on a transactional
# stream: a broadcast stream attaches an unsubscribe footer to a receipt and
# pools its reputation with marketing.
MONACADO_POSTMARK_MESSAGE_STREAM="outbound"

# ---------------------------------------------------------------------------
# Provider event webhook (Phase 1.5) — hard bounces and spam complaints.
#
# POSTMARK DOES NOT SIGN ITS WEBHOOKS. There is no HMAC header to verify. Its
# documented mechanisms are HTTP Basic credentials embedded in the webhook URL
# and a custom header, so a shared secret compared in CONSTANT TIME is the
# strongest thing the provider actually supports. Recorded here rather than left
# for somebody to discover while searching for a signature that does not exist.
#
# Point Postmark's Bounce and SpamComplaint webhooks at
#   POST /api/notifications/email/webhook
# with either Basic credentials or the header X-Monacado-Webhook-Secret.
# ---------------------------------------------------------------------------

MONACADO_POSTMARK_WEBHOOK_SECRET_ENV="MONACADO_POSTMARK_WEBHOOK_SECRET"

# NEVER COMMITTED. Left empty here on purpose.
MONACADO_POSTMARK_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# The dispatcher (Phase 1.5).
#
# One bounded cycle per invocation. No daemon, no scheduler, no loop.
#
#   npm run email:dispatch:once            # the primary operator path
#   POST /api/internal/operations/email-dispatcher   # for a future scheduler
#
# NO CRON SCHEDULE IS WIRED IN THIS PHASE. There is no deployment configuration
# file in this repository to add one to, and inventing one is a deployment
# decision rather than a notification phase's.
#
# The endpoint is gated by a bearer shared secret and answers 401 identically
# for unconfigured, absent, and wrong. An unauthenticated dispatcher endpoint is
# a way for anyone on the internet to make Monacado send its whole queue.
# ---------------------------------------------------------------------------

MONACADO_EMAIL_DISPATCHER_SECRET_ENV="MONACADO_EMAIL_DISPATCHER_SECRET"

# NEVER COMMITTED. Left empty here on purpose.
MONACADO_EMAIL_DISPATCHER_SECRET=""

# ---------------------------------------------------------------------------
# Pre-live commerce controls (Phase 1.2).
#
# NO TAX VENDOR IS CONFIGURED OR INSTALLED. Both providers below are TEST
# adapters. A real engine also needs to know where the buyer is, and Monacado
# collects no buyer address — that is a recorded pre-live blocker, not something
# quietly satisfied here. See docs/PRE_LIVE_COMMERCE_CONTROLS.md.
#
# DISABLED MEANS REFUSED, NOT ZERO. With MONACADO_TAX_ENABLED unset the tax
# adapter THROWS and checkout refuses to sell. A zero returned because tax is
# unconfigured is indistinguishable from a zero that is genuinely correct, and
# the difference is a liability nobody recorded.
#
# None of these are NEXT_PUBLIC_ and none holds a secret.
# ---------------------------------------------------------------------------

# Master switch. Anything other than true/1/yes means disabled (and refusing).
MONACADO_TAX_ENABLED="false"

# TEST_ZERO_RATE  — assesses nothing, and reports OUT_OF_SCOPE rather than
#                   claiming a rate of zero applies.
# TEST_FLAT_RATE  — a fixed rate on retail + shipping, for exercising the flow.
# An unrecognised value REFUSES; it never falls back to zero.
MONACADO_TAX_PROVIDER="TEST_ZERO_RATE"

# TEST_FLAT_RATE only. Basis points, 0..10000. 750 = 7.5%.
# MONACADO_TAX_FLAT_RATE_BASIS_POINTS="750"

# TEST_FLAT_RATE only. A bounded jurisdiction CODE (US-CA, GB) — never an
# address. Recorded on the tax evidence so an auditor knows which regime
# answered.
# MONACADO_TAX_JURISDICTION_CODE="US-CA"

# ---------------------------------------------------------------------------
# Transaction risk gate (Phase 1.2).
#
# Which risk policy gates transactions here. CONFIGURATION, never a request
# parameter — a client that could name the risk policy could name its own
# transaction ceiling.
#
# Deliberately a SEPARATE identity from MONACADO_CHECKOUT_POLICY_ID: one policy
# decides what Monacado EARNS, the other what Monacado PERMITS, and a change to
# either must not move the other.
#
# FAILS CLOSED. With no policy, or a policy with no ACTIVE version, every
# transaction is DENIED with RISK_POLICY_NOT_CONFIGURED. Never a default limit.
#
# Thresholds live in RiskPolicyVersionRow, not here: a limit in an env var is a
# number that changes with no record of who changed it or what an Order was
# evaluated under.
# ---------------------------------------------------------------------------

MONACADO_RISK_POLICY_ID="mon:rpol:REPLACEMEREPLACEMEREPLAC0"

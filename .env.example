# Monacado — environment example (placeholders only; never put real secrets here).
#
# Copy to `.env` (which is git-ignored) and fill in local values.

# Product source-record persistence (Phase 0D).
# Local disposable MySQL only for development/tests — never a production,
# staging, or shared database. Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for a local disposable instance (no password, loopback):
DATABASE_URL="mysql://root@127.0.0.1:3306/monacado_dev"

# ---------------------------------------------------------------------------
# Registrar transport configuration (Phase 0E.6.2).
#
# PLACEHOLDERS ONLY. No real endpoint, Registrar identifier, or credential
# belongs in this file or anywhere else in the repository.
#
# Disabled by default: with MONACADO_REGISTRAR_ENABLED unset, nothing is sent
# and no credential is read. There are deliberately no production defaults.
#
# None of these are NEXT_PUBLIC_ — they must never reach a browser bundle.
# ---------------------------------------------------------------------------

# Master switch. Anything other than true/1/yes means disabled.
MONACADO_REGISTRAR_ENABLED="false"

# The Registrar's own identifier, as issued by that Registrar.
MONACADO_REGISTRAR_ID="an:registrar:REPLACE_ME"

# Absolute REGISTER endpoint. Must be https: and must match one allowed origin
# below exactly — no wildcards, no suffix matching.
MONACADO_REGISTRAR_ENDPOINT="https://registrar.example/v1/register"

# Comma-separated exact origins we may send to.
MONACADO_REGISTRAR_ALLOWED_ORIGINS="https://registrar.example"

# Optional bounds. Defaults: 10000 ms, 65536 bytes.
# MONACADO_REGISTRAR_TIMEOUT_MS="10000"
# MONACADO_REGISTRAR_MAX_RESPONSE_BYTES="65536"

# Only BEARER_ENV is implemented.
MONACADO_REGISTRAR_CREDENTIAL_MODE="BEARER_ENV"

# The NAME of the variable holding the bearer token — NOT the token itself.
# The configuration object stores this name and never the secret value.
MONACADO_REGISTRAR_BEARER_TOKEN_ENV="MONACADO_REGISTRAR_BEARER_TOKEN"

# The named secret itself. Leave UNSET here; supply it out of band (a secret
# manager, or a git-ignored .env that is never committed).
# MONACADO_REGISTRAR_BEARER_TOKEN=

# TEST ONLY. Permits plain http: to a loopback host so the local mock server can
# be used. Must remain false in any real deployment.
# MONACADO_REGISTRAR_ALLOW_LOOPBACK_HTTP="false"

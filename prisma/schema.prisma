// Monacado — Product persistence (Phases 0D, 0E.1–0E.5), publication-worker
// operations (0E.7.3), identity and internal entitlement (0E.7.4.2A),
// marketplace participant persistence (0M.5), Storefront persistence and
// governance (0M.3C), and payment-provider onboarding and activation (0M.8).
//
// The database is the authoritative store for the enduring Product identity and
// its IMMUTABLE source-record version history. Capsule CANDIDATES are never
// stored — they are deterministic derivations regenerated from a persisted
// version via the Phase 0C mapper.
//
// Concerns are kept on separate tables and never merged:
//   Product / ProductSourceRecordVersionRow — identity + immutable Product facts;
//     no Node IDs, capsule IDs, or publication metadata (Phase 0D).
//   ProductNode                              — the AgentNet Node and the ONLY
//     home of ANS lifecycle state (Phase 0E.1).
//   ProductPublication                       — publication identity, lineage,
//     and integrity; no Product facts, no capsule body (Phase 0E.2).
//   PublicationOutbox                        — durable REGISTER work, its claim
//     state, and the ONLY place a published-capsule JSON body is persisted
//     (Phases 0E.2/0E.3). The body is disposed of after successful
//     reconciliation (Phase 0E.4); the row itself is never deleted.
//   RegistrarReceipt                         — the immutable record of what the
//     Registrar said, kept separate from what Monacado expected (Phase 0E.4).
//
// Everything here remains OFFLINE. No Resolver state exists, and no model holds
// a live Registrar/Publisher connection, credential, or endpoint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Stable Monacado Product identity (one row per enduring product).
model Product {
  /// Opaque internal Product identifier (mon:product:<opaque>). Immutable.
  internalProductId String @id @db.VarChar(191)

  /// Opaque source-record identifier (mon:srec:<opaque>), constant across all
  /// versions of this product; distinct from internalProductId.
  sourceRecordId String @unique @db.VarChar(191)

  /// Pointer to the current immutable version's sourceRecordVersion.
  currentSourceRecordVersion String @db.VarChar(64)

  /// Internal Monacado record status (authoring state — NOT ANS lifecycle).
  recordStatus String @db.VarChar(32)

  /// DB row creation time for the stable identity (operational; not a domain field).
  productRowCreatedAt DateTime @default(now()) @db.DateTime(3)

  versions     ProductSourceRecordVersionRow[]
  node         ProductNode?
  publications ProductPublication[]

  // — Offer relations (Phase 0M.6). Both RESTRICT on the far side: an Offer is a
  // commercial commitment against this Product, and its immutable history must
  // not be erasable by deleting the Product beneath it.
  offers              Offer[]
  offerSourceVersions OfferSourceRecordVersionRow[]

  // — Listing relations (Phase 0M.7). Both RESTRICT on the far side: a Listing
  // is a buyer-facing placement of this Product, and its immutable history must
  // not be erasable by deleting the Product beneath it.
  listings              Listing[]
  listingSourceVersions ListingSourceRecordVersionRow[]
  /// Orders for this Product, and the private purchase evidence they
  /// established (0M.9). Both RESTRICT: a Product that has been sold is not
  /// deletable out from under the sale.
  orders                Order[]
  purchaseEvidences     PurchaseEvidence[]

  @@index([sourceRecordId])
}

/// Durable AgentNet Node associated with a Monacado Product (Phase 0E.1).
///
/// The Node is the enduring AgentNet identity anchor; ANS lifecycle lives HERE,
/// never on Product source records or capsules. Populated by Monacado's OFFLINE
/// Registrar-domain operations — no publication records, receipts, or network
/// calls in this phase.
model ProductNode {
  /// Internal surrogate row id.
  id BigInt @id @default(autoincrement())

  /// Opaque Registrar-issued Node ID (an:node:<opaque>); unique and immutable.
  nodeId String @unique @db.VarChar(191)

  /// The stable Product this Node anchors (one Node per Product).
  internalProductId String @unique @db.VarChar(191)

  /// Internal Node classification (NOT encoded into nodeId).
  nodeKind String @db.VarChar(64)

  /// ANS lifecycle state: Active | Inactive | Retired | Revoked.
  lifecycleState      String   @db.VarChar(16)
  lifecycleChangedAt  DateTime @db.DateTime(3)
  lifecycleReasonCode String?  @db.VarChar(64)

  /// Node Policy linkage (reference + version).
  nodePolicyRef     String @db.VarChar(191)
  nodePolicyVersion String @db.VarChar(64)

  /// Registrar identity + optional accreditation reference (accreditation
  /// verification itself is deferred).
  registrarId               String  @db.VarChar(191)
  registrarAccreditationRef String? @db.VarChar(191)

  issuedAt  DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: deleting a Product must not cascade-delete Node history.
  product      Product              @relation(fields: [internalProductId], references: [internalProductId], onDelete: Restrict)
  publications ProductPublication[]

  @@index([internalProductId])
}

/// Immutable authoritative Product source-record version. Never updated in place.
model ProductSourceRecordVersionRow {
  /// Surrogate ordering/PK; deterministic creation order for version listing.
  seq BigInt @id @default(autoincrement())

  // — Identity —
  internalProductId   String @db.VarChar(191)
  sourceRecordId      String @db.VarChar(191)
  sourceRecordVersion String @db.VarChar(64)

  // — Source-system identity —
  sourceSystem     String @db.VarChar(64)
  sourceRecordType String @db.VarChar(64)
  sourceClass      String @db.VarChar(64)

  // — Internal creator authority (opaque governed references) —
  /// The `mon:creator:<opaque>` authority reference this version was authored
  /// under. UNCHANGED by Phase 0M.5: it is part of an immutable historical row,
  /// it is a different identifier scheme from `mon:mpart:`, and rewriting it
  /// would either invent a participant that never existed or silently rename a
  /// committed identity convention.
  authorityCreatorId          String  @db.VarChar(191)
  authorityScope              String  @db.VarChar(64)
  authorityAuthorizationState String  @db.VarChar(32)
  authorityAuthorizationRef   String? @db.VarChar(191)

  /// The MarketplaceParticipant holding creator authority for this version
  /// (Phase 0M.5) — the resolution of this table's long-deferred participant FK.
  ///
  /// ADDITIVE and NULLABLE, beside `authorityCreatorId` rather than replacing it.
  /// This is the same migration-safety pattern `RegistrarReceipt.submissionAttemptId`
  /// used in Phase 0E.5.3: rows written before participants existed carry a
  /// `mon:creator:` reference that matches no participant row, so a NOT NULL
  /// column — or an FK on the existing column — could only be created by
  /// fabricating backfill data. A historical NULL stays readable and can never be
  /// repaired into a participant that did not exist.
  ///
  /// RESTRICT: a participant that authored any Product source version cannot be
  /// deleted. Immutable Product history is never cascade-deleted by a
  /// marketplace-side operation.
  authorityCreatorParticipantId String? @db.VarChar(191)

  // — Product facts (normalized scalars) —
  factName                     String  @db.VarChar(512)
  factDescription              String? @db.Text
  factImage                    String? @db.VarChar(1024)
  factProductVersion           Int
  factPromotable               Boolean
  factGeneralAvailabilityState String  @db.VarChar(32)

  /// DIGITAL | PHYSICAL — how this Product reaches its buyer (Phase 1.2
  /// correction). The ONLY authoritative delivery fact; never inferred from
  /// specifications, capabilities, a name, or a category.
  ///
  /// NULLABLE FOR BACKWARD COMPATIBILITY ONLY. Source versions written before
  /// this fact existed have none, and making it required would invalidate them
  /// retroactively — a source-version model exists so history stays readable.
  /// ABSENCE IS NOT A DEFAULT: checkout FAILS CLOSED on an unknown mode rather
  /// than guessing, because guessing either demands an address nobody needs or
  /// ships nothing to a buyer expecting a parcel.
  factDeliveryMode String? @db.VarChar(16)
  /// Validated JSON: Record<string, string|number|boolean>. Validated by the
  /// ProductData Zod contract before write and after read.
  factSpecifications           Json?
  /// Validated JSON: string[]. Validated by the ProductData Zod contract.
  factCapabilities             Json?
  /// facts.relationships.creator (opaque ANS node reference an:node:<opaque>).
  factCreatorRef               String  @db.VarChar(191)
  /// facts.relationships.offer (optional opaque ANS node reference).
  factOfferRef                 String? @db.VarChar(191)

  // — Mapping controls (NOT Product facts, NOT publication metadata) —
  capsuleSemver      String   @db.VarChar(64)
  mappingVersion     String   @db.VarChar(64)
  capsuleGeneratedAt DateTime @db.DateTime(3)

  // — Source timestamps (domain) —
  acquiredAt      DateTime @db.DateTime(3)
  sourceCreatedAt DateTime @db.DateTime(3)
  sourceUpdatedAt DateTime @db.DateTime(3)

  // — Internal record status (per-version snapshot) —
  recordStatus String @db.VarChar(32)

  // — DB row control (operational; not a domain field) —
  rowCreatedAt DateTime @default(now()) @db.DateTime(3)

  product Product @relation(fields: [internalProductId], references: [internalProductId])

  authorityCreatorParticipant MarketplaceParticipant? @relation(fields: [authorityCreatorParticipantId], references: [id], onDelete: Restrict)

  publications ProductPublication[]

  @@unique([sourceRecordId, sourceRecordVersion])
  @@index([internalProductId, seq])
  @@index([authorityCreatorParticipantId])
}

/// Immutable record that ONE exact Product source-record version was prepared for
/// AgentNet registration as ONE identified capsule, bound to ONE Product Node
/// (Phase 0E.2).
///
/// Holds identity, lineage, and integrity ONLY. No Product facts are duplicated
/// here (they live on the immutable source-record version); no capsule JSON body
/// is stored here (it exists only as the outbox payload); no Node lifecycle is
/// stored here (lifecycle lives on ProductNode — ADR §11.9). Registration and
/// reconciliation state (Phase 0E.4) live here as bounded enums, deliberately
/// separate from publicationStatus, from outboxStatus, and from Node lifecycle;
/// the receipts that drive them are separate immutable rows.
model ProductPublication {
  /// Internal surrogate row id.
  id BigInt @id @default(autoincrement())

  /// Opaque publication identifier (mon:pub:<opaque>); unique and immutable.
  publicationId String @unique @db.VarChar(191)

  /// The stable Product identity (identity, not a Product fact).
  internalProductId String @db.VarChar(191)

  // — Exact immutable source-record lineage (composite FK) —
  sourceRecordId      String @db.VarChar(191)
  sourceRecordVersion String @db.VarChar(64)

  /// The Product Node this capsule binds to (FK to ProductNode.nodeId).
  nodeId String @db.VarChar(191)

  /// Opaque capsule identifier; unique and immutable (one capsule, one publication).
  capsuleId     String @unique @db.VarChar(191)
  capsuleSemver String @db.VarChar(64)

  // — ANS publication metadata —
  publishedBy String   @db.VarChar(191)
  publishedAt DateTime @db.DateTime(3)

  // — Structural policy linkage (effective policy evaluation deferred) —
  nodePolicyRef        String @db.VarChar(191)
  nodePolicyVersion    String @db.VarChar(64)
  capsulePolicyRef     String @db.VarChar(191)
  capsulePolicyVersion String @db.VarChar(64)

  // — Integrity (immutable once written) —
  /// Hash of the regenerated pre-publication candidate.
  candidateHash        String @db.VarChar(80)
  /// The published capsule's own content hash (excludes metadata.contentHash).
  publishedContentHash String @db.VarChar(80)

  // — Mapping controls carried from the source-record version (NOT Product facts) —
  mappingVersion     String   @db.VarChar(64)
  capsuleGeneratedAt DateTime @db.DateTime(3)

  /// Optional prior-capsule references. Mutually exclusive; never a Node ID.
  supersedesCapsuleId String? @db.VarChar(191)
  revokesCapsuleId    String? @db.VarChar(191)

  /// PREPARED | QUEUED | CANCELLED (bounded by the Zod PublicationStatus enum).
  publicationStatus String @db.VarChar(16)

  // — Registrar outcome (Phase 0E.4). Independent of publicationStatus, of
  //   outboxStatus, and of Node lifecycle. Only receipt recording changes these.
  /// NOT_SUBMITTED | PENDING | ACCEPTED | REJECTED.
  registrationState String @default("NOT_SUBMITTED") @db.VarChar(16)

  /// NOT_REQUIRED | PENDING | MATCHED | MISMATCH — whether a recorded receipt
  /// actually refers to THIS publication.
  reconciliationState String @default("NOT_REQUIRED") @db.VarChar(16)

  /// NOT_REQUIRED | REQUIRED | RETRY_AUTHORIZED | CLOSED | RESOLVED (Phase 0E.5.2).
  /// Whether a human decision is needed about a failed or misidentified
  /// registration, and what was decided. Deliberately separate from
  /// publicationStatus, registrationState, reconciliationState, outboxStatus,
  /// and Node lifecycle.
  remediationState String @default("NOT_REQUIRED") @db.VarChar(24)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT everywhere: publication history must never be cascade-deleted, and
  // the referenced source version / Node / Product cannot be removed beneath it.
  product       Product                       @relation(fields: [internalProductId], references: [internalProductId], onDelete: Restrict)
  node          ProductNode                   @relation(fields: [nodeId], references: [nodeId], onDelete: Restrict)
  sourceVersion ProductSourceRecordVersionRow @relation(fields: [sourceRecordId, sourceRecordVersion], references: [sourceRecordId, sourceRecordVersion], onDelete: Restrict)

  outbox             PublicationOutbox?
  receipts           RegistrarReceipt[]
  remediations       PublicationRemediation[]
  submissionAttempts PublicationSubmissionAttempt[]

  /// One publication per (Node, exact source-record version) — prevents two
  /// conflicting capsule identities being published for the same source version.
  @@unique([nodeId, sourceRecordId, sourceRecordVersion])
  @@index([internalProductId])
  @@index([sourceRecordId, sourceRecordVersion])
}

/// Durable publication work item (Phase 0E.2). Exactly one REGISTER item per
/// prepared publication, created in the SAME transaction as the publication.
///
/// This phase persists only PENDING work. There are deliberately NO claim, lock,
/// lease, retry, error, dead-letter, receipt, reconciliation, completion, or
/// payload-disposal fields — those belong to later phases.
model PublicationOutbox {
  /// Internal surrogate row id.
  id BigInt @id @default(autoincrement())

  /// Opaque outbox identifier (mon:obx:<opaque>); unique. Derived deterministically
  /// from the idempotency key.
  outboxId String @unique @db.VarChar(191)

  /// One-to-one with the publication (one REGISTER item per publication).
  publicationId String @unique @db.VarChar(191)

  /// Deterministic sha256 over the stable preparation identity; unique.
  idempotencyKey String @unique @db.VarChar(191)

  /// REGISTER only in this phase (bounded by the Zod OutboxOperationType enum).
  operationType String @db.VarChar(32)

  /// The validated FINAL published Product capsule. Strict-schema JSON, validated
  /// on read; never an arbitrary bag and never carries secrets or credentials.
  ///
  /// NULLABLE from Phase 0E.4: the transient body is disposed of after a matching
  /// ACCEPTED Registrar receipt. Absence is legitimate ONLY in COMPLETED. The row
  /// itself is never deleted, and payloadHash is retained so the disposed body
  /// remains verifiable against a regenerated capsule.
  payload Json?

  /// Canonical hash of the payload exactly as stored.
  payloadHash String @db.VarChar(80)

  /// PENDING | PROCESSING | RETRYABLE | COMPLETED | DEAD_LETTER | CANCELLED
  /// (bounded by the Zod OutboxStatus enum).
  outboxStatus String @db.VarChar(16)

  /// Claims made against this item; incremented by each successful claim.
  attemptCount Int @default(0)

  /// Earliest time this item may be claimed; rescheduled on each retry.
  availableAt DateTime @db.DateTime(3)

  // — Claim ownership (Phase 0E.3). Both NULL unless the item is PROCESSING. —
  /// When the current claim was taken.
  lockedAt DateTime? @db.DateTime(3)

  /// Opaque proof of claim ownership (mon:lock:<opaque>); unique while held.
  /// NULL when unclaimed — MySQL permits many NULLs under a unique index.
  lockToken String? @unique @db.VarChar(191)

  /// When the current claim's lease expires (Phase 0E.5.1). Computed explicitly
  /// at claim time from a supplied `now` plus a bounded lease duration — never
  /// from a clock read inside the repository.
  ///
  /// Present if and only if the item is PROCESSING: every path leaving PROCESSING
  /// clears it. Once `leaseExpiresAt <= now`, the claim is stale and may be
  /// recovered back to RETRYABLE so a crashed worker cannot strand the item.
  leaseExpiresAt DateTime? @db.DateTime(3)

  // — Outcome (Phase 0E.3). No receipt, registration, or reconciliation state. —
  /// Set only when the attempt COMPLETED.
  completedAt DateTime? @db.DateTime(3)

  /// Bounded, sanitised failure metadata from the last failed attempt. Rejects
  /// credentials, connection strings, integrity hashes, and capsule content at
  /// the contract boundary — see contracts/product/safe-error-metadata.
  lastErrorCode    String? @db.VarChar(64)
  lastErrorSummary String? @db.VarChar(256)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  publication        ProductPublication             @relation(fields: [publicationId], references: [publicationId], onDelete: Restrict)
  receipts           RegistrarReceipt[]
  remediations       PublicationRemediation[]
  submissionAttempts PublicationSubmissionAttempt[]

  /// Supports the claim query: filter by status, order by availableAt then
  /// creation order. InnoDB appends the primary key (`id`) to every secondary
  /// index, so the deterministic (availableAt, id) tiebreak is served by this
  /// index without a redundant explicit column — and the index is unchanged from
  /// Phase 0E.2, keeping this migration additive (new columns only).
  @@index([outboxStatus, availableAt])
  /// Supports the stale-claim sweep: find PROCESSING items whose lease has expired.
  @@index([outboxStatus, leaseExpiresAt])
}

/// Immutable record of what the Registrar said about one publication (Phase 0E.4).
///
/// Written once and never updated: there is no `updatedAt`, and no service
/// mutates a receipt. A receipt is EVIDENCE, not authority — recording one never
/// rewrites the publication's expected Node, capsule, or content hash. The
/// capsule body is never stored here.
model RegistrarReceipt {
  /// Internal surrogate row id.
  id BigInt @id @default(autoincrement())

  /// Opaque internal receipt identifier (mon:rcpt:<opaque>); unique.
  receiptId String @unique @db.VarChar(191)

  /// The publication this receipt claims to describe.
  publicationId String @db.VarChar(191)

  /// The outbox item whose attempt produced it, when known.
  outboxId String? @db.VarChar(191)

  /// The Registrar's OWN registration identifier; unique where present.
  /// NULL for a REJECTED receipt that registered nothing (MySQL allows many NULLs).
  registrarRegistrationId String? @unique @db.VarChar(191)

  /// What the receipt reports. Compared against the publication's expectation;
  /// never copied over it.
  registrarId           String @db.VarChar(191)
  nodeId                String @db.VarChar(191)
  capsuleId             String @db.VarChar(191)
  registeredContentHash String @db.VarChar(80)

  /// ACCEPTED | REJECTED (bounded by the Zod ReceiptStatus enum).
  receiptStatus String @db.VarChar(16)

  /// Registrar's registration time, and Monacado's receiving time.
  registeredAt DateTime @db.DateTime(3)
  receivedAt   DateTime @db.DateTime(3)

  /// Narrow, closed, validated detail structure — never an arbitrary bag and
  /// never the capsule body. See contracts/product/product-registrar-receipt.
  receiptDetails Json

  /// The exact outbound attempt this receipt answers (Phase 0E.5.3).
  ///
  /// NULLABLE only so the migration is safe for receipt rows recorded before
  /// this phase existed. The SERVICE requires it for every new receipt; a
  /// historical NULL remains readable but can never be created again. Unique, so
  /// one attempt can carry at most one authoritative receipt.
  submissionAttemptId String? @unique @db.VarChar(191)

  /// Set to publicationId for an ACCEPTED receipt and NULL otherwise, so the
  /// unique index enforces AT MOST ONE ACCEPTED RECEIPT PER PUBLICATION while
  /// permitting many rejected/mismatched receipts (MySQL has no partial indexes).
  acceptedForPublicationId String? @unique @db.VarChar(191)

  createdAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT: receipt history must never be cascade-deleted.
  publication       ProductPublication            @relation(fields: [publicationId], references: [publicationId], onDelete: Restrict)
  outbox            PublicationOutbox?            @relation(fields: [outboxId], references: [outboxId], onDelete: Restrict)
  submissionAttempt PublicationSubmissionAttempt? @relation(fields: [submissionAttemptId], references: [submissionAttemptId], onDelete: Restrict)

  @@index([publicationId])
  @@index([outboxId])
}

/// Immutable record of ONE governed human decision about a publication whose
/// registration failed or could not be reconciled (Phase 0E.5.2).
///
/// Written once and never updated: there is no `updatedAt` and no service
/// mutates a remediation. It records WHO decided WHAT, WHY, and WHEN, plus the
/// state the publication was in beforehand — an audit trail, not a workflow
/// engine. Registrar receipts are never overwritten or deleted by remediation,
/// and no receipt or capsule body is copied into this row.
model PublicationRemediation {
  /// Internal surrogate row id.
  id BigInt @id @default(autoincrement())

  /// Opaque internal remediation identifier (mon:rem:<opaque>); unique.
  remediationId String @unique @db.VarChar(191)

  /// The publication this decision is about.
  publicationId String @db.VarChar(191)

  /// The work item at the time of the decision, when there was one.
  outboxId String? @db.VarChar(191)

  /// RETRY | CLOSE (bounded by the Zod RemediationAction enum).
  remediationAction String @db.VarChar(16)

  // — The state the decision was made against (audit; never rewritten) —
  priorRegistrationState   String @db.VarChar(16)
  priorReconciliationState String @db.VarChar(16)
  priorOutboxStatus        String @db.VarChar(16)
  priorRemediationState    String @db.VarChar(24)

  /// Bounded, sanitised justification. Same safe-metadata rules as outbox error
  /// fields: credentials, connection strings, hashes, and capsule content are
  /// refused at the contract boundary.
  reasonCode    String  @db.VarChar(64)
  reasonSummary String? @db.VarChar(256)

  /// Opaque actor identifier (mon:actor:<opaque>) — never an email address,
  /// display name, or other private profile data.
  decidedBy String   @db.VarChar(191)
  decidedAt DateTime @db.DateTime(3)

  /// For RETRY: when the re-authorised work item becomes eligible again.
  retryAvailableAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT: remediation history must never be cascade-deleted.
  publication ProductPublication @relation(fields: [publicationId], references: [publicationId], onDelete: Restrict)
  outbox      PublicationOutbox? @relation(fields: [outboxId], references: [outboxId], onDelete: Restrict)

  @@index([publicationId])
  @@index([outboxId])
}

/// Immutable identity for ONE outbound Product registration attempt (Phase 0E.5.3).
///
/// A worker's `lockToken` says WHO may work on an item right now; a submission
/// attempt says WHAT was sent. Without it, a Registrar receipt could only be
/// matched by publication identity and hashes, so a late receipt answering an
/// abandoned attempt was indistinguishable from one answering the current retry.
///
/// The raw lock token is NEVER persisted — only a one-way `claimTokenHash`, so a
/// leaked row yields no reusable credential. No capsule payload and no receipt
/// body are stored here. Identity, hashes, attempt number, and timestamps are
/// immutable; the only writes after creation are the narrow guarded lifecycle
/// transitions (PREPARED → DISPATCHED → RECEIPT_RECORDED, or → ABANDONED).
model PublicationSubmissionAttempt {
  /// Internal surrogate row id.
  id BigInt @id @default(autoincrement())

  /// Opaque attempt identifier (mon:attempt:<opaque>); unique and immutable.
  submissionAttemptId String @unique @db.VarChar(191)

  /// The publication and the work item this attempt belongs to.
  publicationId String @db.VarChar(191)
  outboxId      String @db.VarChar(191)

  /// The outbox `attemptCount` this attempt was prepared against.
  attemptNumber Int

  /// REGISTER only in this phase.
  operation String @db.VarChar(32)

  // — Immutable expectation, captured at preparation. A receipt must reconcile
  //   against THESE values, not against whatever the publication says later. —
  nodeId              String @db.VarChar(191)
  capsuleId           String @db.VarChar(191)
  registrarId         String @db.VarChar(191)
  expectedContentHash String @db.VarChar(80)
  payloadHash         String @db.VarChar(80)

  /// One-way SHA-256 binding to the claim that prepared this attempt. The raw
  /// lock token is never stored.
  claimTokenHash String @db.VarChar(80)

  /// PREPARED | DISPATCHED | RECEIPT_RECORDED | ABANDONED.
  attemptStatus String @db.VarChar(24)

  preparedAt   DateTime  @db.DateTime(3)
  dispatchedAt DateTime? @db.DateTime(3)
  abandonedAt  DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT: attempt history must never be cascade-deleted.
  publication ProductPublication @relation(fields: [publicationId], references: [publicationId], onDelete: Restrict)
  outbox      PublicationOutbox  @relation(fields: [outboxId], references: [outboxId], onDelete: Restrict)
  receipt     RegistrarReceipt?

  /// One attempt per claim: an outbox item may attempt each attemptCount once.
  @@unique([outboxId, attemptNumber])
  @@index([publicationId])
  @@index([attemptStatus])
}

/// Durable operational evidence for ONE invocation of the one-shot publication
/// worker command (Phase 0E.7.3).
///
/// This is operational infrastructure state, NOT a publishable capsule and NOT an
/// authority over anything. Publication, outbox, submission-attempt, receipt, and
/// remediation rows remain the sole authorities for what happened to the work
/// itself; this table only records that a command ran, what bounded outcome it
/// reported, and how much it attempted. Nothing here is ever read back to decide
/// domain state.
///
/// It therefore has NO relation to any domain table — deliberately. A foreign key
/// would imply this row participates in publication integrity, and would make
/// operational history undeletable alongside domain history.
///
/// Every column is a bounded scalar. There is **no JSON column**, so there is
/// nowhere for arbitrary metadata, a payload, a receipt body, a raw exception, or
/// a stack trace to accumulate. Issue codes are stored as a sorted, comma-joined
/// list of SCREAMING_SNAKE_CASE codes, which cannot contain a comma by their own
/// shape — deterministic to serialise and trivially safe to read.
model PublicationWorkerRun {
  /// Internal surrogate row id. Never projected out of the service layer.
  id BigInt @id @default(autoincrement())

  /// The command's correlation id, shared with its JSON-lines monitoring output.
  /// Unique: one durable row per invocation that reaches the runnable boundary.
  cycleId String @unique @db.VarChar(64)

  /// STARTED | COMPLETED | FAILED | ABANDONED.
  status String @db.VarChar(16)

  /// The Phase 0E.7.1 cycle outcome, once one exists. Null while STARTED, and for
  /// a run that failed or was abandoned before producing a cycle result.
  /// DISABLED | NO_WORK | COMPLETED | RUN_LIMIT_REACHED | SHUTDOWN_REQUESTED | FAILED.
  workerOutcome String? @db.VarChar(24)

  /// The process exit code this command reported. Bounded 0..255.
  exitCode Int?

  /// The bound the command was configured with, and what it actually did.
  maximumRuns   Int
  runsAttempted Int @default(0)
  itemsClaimed  Int @default(0)

  stoppedForNoWork  Boolean @default(false)
  shutdownRequested Boolean @default(false)

  /// Safe counts from the optional one-time stale-claim recovery sweep.
  expiredClaimsExamined  Int @default(0)
  expiredClaimsRecovered Int @default(0)
  expiredClaimsSkipped   Int @default(0)

  /// Sorted, deduplicated, comma-joined bounded issue codes. Empty when none.
  /// Codes only — never a message, cause, or driver detail.
  issueCodes String @default("") @db.VarChar(1024)

  /// Explicit instants supplied by the caller; this table reads no clock.
  startedAt   DateTime  @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  /// Stale-run reconciliation scans non-terminal rows oldest-first.
  @@index([status, startedAt])
  /// Recent-history and health queries order by terminal instant, then identity.
  @@index([completedAt])
  @@index([startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity, session, and internal entitlement foundation (Phase 0E.7.4.2A).
//
// Relational-first operational identity. An account is NOT a publishable
// descriptive entity: the ADR's capsule-backed entities are Product, Storefront,
// Creator, Promoter, Listing, and Offer, and a person's login is none of those.
// Nothing here is ever published, and no capsule references these rows.
//
// This is the minimum honest foundation for authenticating a human and proving
// an explicit internal operational entitlement. It is deliberately NOT a role
// system: there is one capability vocabulary, validated in the application layer,
// and no generalized RBAC.
// ─────────────────────────────────────────────────────────────────────────────

/// One human account. Credentials only — no profile, no Stripe, no underwriting.
model Account {
  /// Opaque durable identity (mon:acct:<opaque>). The ONLY key authorization
  /// uses. Never derived from the email, which is a mutable contact detail.
  id String @id @db.VarChar(191)

  /// Display name. Never authoritative for identity or authorization.
  name String @db.VarChar(191)

  /// The address as the person typed it, kept for display and correspondence.
  email String @db.VarChar(320)

  /// Deterministically normalised address. Authoritative for lookup and
  /// uniqueness, so `Ada@Example.com` and `ada@example.com` cannot both exist.
  normalizedEmail String @unique @db.VarChar(320)

  /// Argon2id PHC string. Never a plaintext or reversibly encrypted password.
  passwordHash String @db.VarChar(255)

  /// ACTIVE | DISABLED. A DISABLED account cannot authenticate, and every one of
  /// its existing sessions stops resolving immediately.
  status String @db.VarChar(16)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  sessions     AccountSession[]
  entitlements AccountEntitlement[]

  /// At most one marketplace participant (Phase 0M.5). The account remains the
  /// authentication identity; the participant is who transacts.
  participant MarketplaceParticipant?

  /// Orders placed by this account, and guest Orders later claimed by it (0M.9).
  /// Both RESTRICT: an account that has bought something is not deletable out
  /// from under its own purchase history.
  ordersPlaced  Order[] @relation("OrderBuyerAccount")
  ordersClaimed Order[] @relation("OrderClaimedByAccount")

  @@index([status])
}

/// One server-side session. Opaque and revocable — deliberately not a JWT.
model AccountSession {
  /// Opaque session-row identity (mon:asess:<opaque>). Not the session token.
  id String @id @db.VarChar(191)

  accountId String @db.VarChar(191)

  /// SHA-256 of the session token, hex. The raw token is returned once at
  /// creation and NEVER persisted, so a database disclosure yields no usable
  /// credential. A fast hash is correct here precisely because the token is 256
  /// bits of randomness rather than a low-entropy human secret.
  tokenHash String @unique @db.VarChar(64)

  createdAt  DateTime  @db.DateTime(3)
  expiresAt  DateTime  @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)
  lastSeenAt DateTime? @db.DateTime(3)

  // CASCADE: a session is an ephemeral credential, not history. Deleting the
  // account must not leave a resolvable session behind.
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@index([accountId, revokedAt, expiresAt])
}

/// One explicit grant of one capability to one account.
model AccountEntitlement {
  /// Opaque entitlement identity (mon:aent:<opaque>).
  id String @id @db.VarChar(191)

  accountId String @db.VarChar(191)

  /// A member of the closed capability vocabulary, validated in the application
  /// layer. Not a free-form role or permission string.
  capability String @db.VarChar(64)

  /// ACTIVE | REVOKED. Revocation fails closed on the very next request, because
  /// authorization reads this row rather than anything cached in a token.
  status String @db.VarChar(16)

  grantedAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: an entitlement is an authorization record. Deleting an account
  // that still holds one must be refused, forcing an explicit revocation first
  // rather than silently dropping the grant.
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  /// One row per account+capability: granting an already-granted capability is
  /// idempotent, and revocation flips this row rather than appending. A full
  /// grant/revoke audit log is deliberately deferred.
  @@unique([accountId, capability])
  @@index([accountId, capability, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketplace participant persistence and draft onboarding (Phase 0M.5).
//
// The relational foundation the completed 0M contracts already depend on: every
// one of them names a `mon:mpart:` identity that until now had no table.
//
// Four separations are load-bearing here, and each is a separate table or a
// deliberate absence rather than a column on one row:
//
//   1. **Account is not participant.** `Account` answers "who authenticated";
//      `MarketplaceParticipant` answers "who is transacting". Disabling a login
//      and suspending a seller must stay different operations.
//   2. **Participant status is not role status.** Admission is participant-wide;
//      each role carries its own lifecycle, because a suspended PROMOTER role
//      must not imply a suspended SELLER role on the same participant.
//   3. **Payment readiness had NO storage in this phase.** There was no
//      `ParticipantPaymentAccount` table and no readiness column — so nothing
//      here could report ENABLED, by construction rather than by discipline.
//      Materialization reported the initial `NOT_STARTED`. **Phase 0M.8 added
//      the real provider axis** (see `ParticipantPaymentAccount` below); the
//      separation itself is unchanged — readiness is still a table of its own,
//      never a column on the participant.
//   4. **Private profile CONTENT has no storage either.** `ParticipantProfile`
//      holds completion markers and onboarding gates only — no legal name, no
//      address, no date of birth, no tax id, no document, no provider
//      identifier, no moderation note. A field that does not exist cannot leak
//      into a projection, which is a stronger guarantee than a denylist.
//
// Nothing here is publishable. No participant Node, no participant capsule, and
// no projection is created by this phase; the public projection's permitted
// field set is recorded as a contract allow-list and implemented by nobody yet.
// ─────────────────────────────────────────────────────────────────────────────

/// The marketplace identity of one account: who is transacting (Phase 0M.5).
model MarketplaceParticipant {
  /// Opaque durable identity (mon:mpart:<opaque>). Distinct from the account id
  /// by construction — the account id answers "who authenticated", and collapsing
  /// them would make every marketplace record reachable from an auth key.
  id String @id @db.VarChar(191)

  /// One participant per account.
  accountId String @unique @db.VarChar(191)

  /// Monacado's ADMISSION lifecycle — never the account's, never a role's, and
  /// never the payment provider's. DRAFT | PROFILE_INCOMPLETE | PROFILE_COMPLETE
  /// | UNDER_REVIEW | ACTIVE | RESTRICTED | SUSPENDED | CLOSED, bounded by the
  /// Zod ParticipantStatus enum and the 0M.1 transition table.
  ///
  /// Phase 0M.5 writes only the drafting subset. UNDER_REVIEW, ACTIVE,
  /// RESTRICTED, and SUSPENDED are refused by the service: reaching them is an
  /// activation decision, and this phase makes none.
  status String @db.VarChar(24)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: a participant anchors commercial history. Deleting an account that
  // holds one must be refused, forcing an explicit closure first.
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  roles       MarketplaceRoleAssignment[]
  profile     ParticipantProfile?
  activations ParticipantActivation[]

  /// Payment-provider linkage (Phase 0M.8). RESTRICT on the far side — provider
  /// linkage is evidence behind an activation decision.
  paymentAccounts ParticipantPaymentAccount[]

  /// Governed restrictions (Phase 0M.R1). RESTRICT on the far side — a
  /// restriction is the evidence behind a RESTRICTED status.
  restrictions ParticipantRestriction[]

  /// Notification obligations owed TO this participant (Phase 0M.N1). RESTRICT
  /// on the far side — an obligation Monacado owes must not vanish with a delete.
  notificationObligations NotificationObligation[]
  notificationDeliveries  NotificationDelivery[]

  /// Product source versions authored under this participant's creator authority.
  /// RESTRICT on the far side — immutable Product history is never cascade-deleted.
  authoredProductSourceVersions ProductSourceRecordVersionRow[]

  // — Storefront relations (Phase 0M.3C). All RESTRICT on the far side. —
  ownedStorefronts                Storefront[]
  ownedStorefrontSourceVersions   StorefrontSourceRecordVersionRow[] @relation("StorefrontVersionOwner")
  authorizedStorefrontVersions    StorefrontSourceRecordVersionRow[] @relation("StorefrontVersionAuthorizer")
  storefrontGovernanceAssignments StorefrontGovernanceAssignment[]

  // — Offer relations (Phase 0M.6). All RESTRICT on the far side. Seller
  // authority over an Offer is transactional identity, never a Creator Node.
  sellerOffers              Offer[]                       @relation("OfferSeller")
  sellerOfferSourceVersions OfferSourceRecordVersionRow[] @relation("OfferVersionSeller")
  authorizedOfferVersions   OfferSourceRecordVersionRow[] @relation("OfferVersionAuthorizer")

  // — Listing relations (Phase 0M.7). All RESTRICT on the far side. The
  // controller is a seller or a promoter depending on the Listing branch; roles
  // stay additive assignments and no separate identity table exists for either.
  controlledListings        Listing[]                       @relation("ListingController")
  controlledListingVersions ListingSourceRecordVersionRow[] @relation("ListingVersionController")
  authorizedListingVersions ListingSourceRecordVersionRow[] @relation("ListingVersionAuthorizer")

  // — Order and post-sale relations (Phase 0M.9). All RESTRICT on the far side.
  //
  // `buyerOrders` exists only for an account holder who ALREADY held a
  // participant record; buying requires no participant, and a guest never gets
  // one fabricated. Selling and promoting are the roles that gate commerce.
  buyerOrders    Order[] @relation("OrderBuyerParticipant")
  soldOrders     Order[] @relation("OrderSeller")
  promotedOrders Order[] @relation("OrderPromoter")

  /// What Monacado owes this participant for completed sales.
  proceedsObligations ProceedsObligation[]

  /// Purchase evidence naming this participant as the seller reviewed.
  purchaseEvidenceAsSeller PurchaseEvidence[]

  /// Monacado's governed commerce-approval decisions about this participant
  /// (0M.9). RESTRICT: the evidence behind every sale they made.
  commerceApprovals ParticipantCommerceApproval[]

  @@index([status])
}

/// One additive role grant on one participant (Phase 0M.5).
///
/// Roles are additive, never a hierarchy: SELLER, PROMOTER, and BUYER coexist on
/// one participant, and ADR §11.5 forbids issuing a second Node merely because a
/// participant holds several roles.
model MarketplaceRoleAssignment {
  /// Opaque identity (mon:mrole:<opaque>).
  id String @id @db.VarChar(191)

  participantId String @db.VarChar(191)

  /// SELLER | PROMOTER | BUYER, bounded by the Zod MarketplaceRole enum.
  /// INTERNAL_OPERATOR is deliberately absent — that is an AccountEntitlement,
  /// and one enum serving both questions is how a Monacado employee ends up
  /// holding seller authority.
  role String @db.VarChar(16)

  /// DRAFT | PENDING_ACTIVATION | ACTIVE | SUSPENDED | REVOKED.
  ///
  /// SELLER and PROMOTER are created DRAFT; BUYER is created ACTIVE, because
  /// guest checkout is a first-class path and a buyer role requiring approval
  /// would be stricter than buying with no account at all.
  status String @db.VarChar(24)

  grantedAt   DateTime  @db.DateTime(3)
  activatedAt DateTime? @db.DateTime(3)
  revokedAt   DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: an authorization record. Revocation is a state change, not a
  // delete, so the grant history survives.
  participant MarketplaceParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  /// One assignment per role per participant — granting a held role is
  /// idempotent rather than duplicating the grant.
  @@unique([participantId, role])
  @@index([participantId, status])
}

/// The private onboarding profile of one participant (Phase 0M.5).
///
/// **Completion markers and onboarding gates ONLY.** There is deliberately no
/// column for a legal name, trading name, address, date of birth, tax
/// identifier, document reference, bank or payout detail, provider account id,
/// provider secret, phone number, private contact field, or internal moderation
/// note. Phase 0M.1 §9 defers the field-level contents, and the thesis requires
/// them to be driven dynamically rather than frozen into a static global
/// checklist — so this table records WHICH sections are satisfied, never WHAT
/// was supplied.
///
/// That is the privacy control. A projection cannot leak a column that does not
/// exist, which holds even against code nobody has written yet.
///
/// There is no stored `completeness`: it is DERIVED from the markers and gates
/// below, on the same reasoning that keeps `isLive` off the Storefront source
/// model. A stored copy is a second answer that can disagree with the first.
model ParticipantProfile {
  /// Opaque identity (mon:mprof:<opaque>).
  id String @id @db.VarChar(191)

  /// One profile per participant.
  participantId String @unique @db.VarChar(191)

  // — Section completion markers. Booleans, not content. —
  identityComplete            Boolean @default(false)
  businessStructureComplete   Boolean @default(false)
  representativesComplete     Boolean @default(false)
  commercialProfileComplete   Boolean @default(false)
  riskComplete                Boolean @default(false)
  payoutConfigurationComplete Boolean @default(false)
  documentsComplete           Boolean @default(false)

  // — Onboarding gates (0M.1 open decision 2, settled in 0M.5) —
  //
  // Email verification and terms acceptance are OPERATIONAL onboarding gates,
  // enforced here as profile prerequisites. They are never capsule facts and
  // never participant statuses: a distinct status would duplicate an
  // account-level fact on the marketplace axis.
  //
  // The verified ADDRESS is not stored here — only the instant verification
  // completed. The address itself stays on Account, where it already is.
  emailVerifiedAt DateTime? @db.DateTime(3)
  termsAcceptedAt DateTime? @db.DateTime(3)

  /// Which terms version was accepted. A version label, never the document.
  termsVersion String? @db.VarChar(64)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // CASCADE: the profile is subordinate onboarding state, not history. It exists
  // only to describe its participant, and must not outlive it.
  participant MarketplaceParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

/// One governed activation review and its decision (table 0M.5; written 0M.8).
///
/// Phase 0M.5 created this table and wrote no row into it, so the participant's
/// admission axis had a real audit home from the start rather than an activation
/// being invented as a status write with no record of who decided it. **Phase
/// 0M.8 is the phase that writes it**: submission appends an undecided row, and
/// the governed review fills the decision fields in once.
///
/// Append-only: one row per submission, and the decision fields are filled in
/// once — a decided row is never re-decided, and a second submission is a second
/// row. No capsule, no publication, no payment state; the provider axis lives on
/// `ParticipantPaymentAccount` and is read as evidence, never copied here.
model ParticipantActivation {
  /// Opaque identity (mon:mact:<opaque>).
  id String @id @db.VarChar(191)

  participantId String @db.VarChar(191)

  submittedAt DateTime @db.DateTime(3)

  /// APPROVED | MORE_INFORMATION_REQUIRED | REJECTED. NULL while undecided.
  decision  String?   @db.VarChar(32)
  decidedAt DateTime? @db.DateTime(3)

  /// Who decided, as an opaque `mon:acct:` identity — never an email address or
  /// a display name.
  ///
  /// Phase 0M.8 resolved this to the reviewing ACCOUNT id rather than the
  /// separate `mon:actor:` form 0M.1 §9 anticipated. An activation reviewer has
  /// an account behind it (a remediation decision does not), and the identity
  /// foundation already rules that the account id IS the actor id. Writing the
  /// same identity that `activation:review` was evaluated against is what binds
  /// the audit actor to the authorized reviewer — two separate identities could
  /// disagree, and this row would then name someone who was never checked.
  ///
  /// The column is unchanged: VARCHAR(191), nullable while undecided.
  decidedByActorId String? @db.VarChar(191)

  /// Bounded decision reason code. A classification, never free text and never
  /// private profile content.
  decisionReasonCode String? @db.VarChar(64)

  /// Set to participantId while UNDECIDED and NULL once decided, so this unique
  /// index enforces AT MOST ONE UNDECIDED ACTIVATION PER PARTICIPANT while
  /// permitting any number of decided ones. MySQL has no partial indexes; this
  /// is the same technique `RegistrarReceipt.acceptedForPublicationId` uses.
  undecidedForParticipantId String? @unique @db.VarChar(191)

  createdAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT: the audit trail for admission must never be cascade-deleted.
  participant MarketplaceParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([participantId, submittedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment-provider onboarding and readiness (Phase 0M.8).
//
// The provider axis 0M.5 deliberately left with no storage. Until now
// materialization reported the initial `NOT_STARTED` from a constant, so nothing
// could report ENABLED by construction; these two tables are the real answer.
//
// Four boundaries are load-bearing:
//
//   1. **Provider-neutral.** `readiness` is Monacado's own
//      `PaymentReadinessStatus` — NOT_STARTED | DETAILS_REQUIRED |
//      PENDING_PROVIDER | ENABLED | RESTRICTED | DISABLED — bounded by the 0M.1
//      enum and its transition table. There is no `charges_enabled`, no
//      `payouts_enabled`, no `capabilities`, and no `requirements` column. The
//      provider's model is mapped onto this one, never substituted for it.
//   2. **Observed, not assumed.** `readinessObservedAt` records WHEN the
//      provider last answered. A row with a readiness and no observation instant
//      would be Monacado's guess wearing the provider's clothes.
//   3. **No credential and no dossier.** There is deliberately no column for an
//      API key, bearer token, webhook secret, bank account or routing number,
//      card number, tax identifier, SSN, date of birth, legal name, address,
//      identity document, document URL, raw KYC/KYB payload, or provider error
//      body. Outstanding requirements are bounded CATEGORY codes on a child
//      table — enough to know onboarding is incomplete, never enough to be the
//      provider's underwriting file.
//   4. **No money.** No charge, payment intent, order, capture, refund,
//      chargeback, settlement, payout, or ledger table is created by this phase,
//      and none of these columns holds an amount.
//
// Payment readiness is ONE axis, matching the committed 0M.1 contract that
// `canReceivePayout` reads. No payout-specific readiness is invented here.
// ─────────────────────────────────────────────────────────────────────────────

/// Monacado's record of one participant's linkage to one payment provider.
///
/// Named `mon:mpay:` — Monacado's own row, not the provider's account. The
/// provider's identifier is a FIELD on this row and never its identity, so the
/// generic lifecycle never becomes provider-shaped.
model ParticipantPaymentAccount {
  /// Opaque identity (mon:mpay:<opaque>).
  id String @id @db.VarChar(191)

  participantId String @db.VarChar(191)

  /// Which external party this account is with. A closed Zod enum. Naming the
  /// counterparty is a Monacado fact; nothing provider-SHAPED appears anywhere
  /// else in this model.
  provider String @db.VarChar(32)

  /// The provider's opaque account reference, persisted for reconciliation only.
  ///
  /// **Not an AgentNet Node, not a capsule identity, and never published.**
  /// Participant identity is never inferred from it — the FK is the only
  /// linkage. The contract refuses a `mon:` form and refuses provider-secret
  /// prefixes, so a key pasted here is a validation failure, not a stored
  /// credential.
  providerAccountRef String @db.VarChar(191)

  /// The provider's answer as Monacado last observed it. NOT_STARTED |
  /// DETAILS_REQUIRED | PENDING_PROVIDER | ENABLED | RESTRICTED | DISABLED.
  ///
  /// Created NOT_STARTED and moved only through the 0M.1
  /// PAYMENT_READINESS_TRANSITIONS table. NOT_STARTED -> ENABLED is not a
  /// transition: readiness is always the provider's answer, never Monacado's.
  readiness String @db.VarChar(24)

  /// When that answer was observed. NULL until the first observation — a linked
  /// account has been created, not yet asked.
  readinessObservedAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: provider linkage is evidence behind an activation decision and,
  // later, behind every payout attribution. Deleting a participant that holds
  // one must be refused.
  participant  MarketplaceParticipant             @relation(fields: [participantId], references: [id], onDelete: Restrict)
  requirements ParticipantPaymentRequirementRow[]

  /// One account per participant per provider (0M.1 §9).
  @@unique([participantId, provider])
  /// One provider account belongs to exactly one participant. Without this, the
  /// same external account could be claimed by two participants and every payout
  /// attribution built on it would be ambiguous.
  @@unique([provider, providerAccountRef])
  @@index([readiness])
}

/// One outstanding provider requirement CATEGORY on one payment account.
///
/// A child table rather than a delimited column so each outstanding category is
/// a row that can be indexed, counted, and constrained. Every value is a member
/// of the closed `PaymentRequirementCode` enum.
///
/// **It says WHERE onboarding is incomplete, never WHAT the provider asked
/// for.** There is no column for a document reference, a field name, a rejection
/// reason, a person, or a provider message — so this table cannot become the
/// provider's underwriting dossier by accretion.
model ParticipantPaymentRequirementRow {
  /// Surrogate key. The meaningful uniqueness is the pair below.
  seq BigInt @id @default(autoincrement())

  paymentAccountId String @db.VarChar(191)

  /// IDENTITY_DETAILS_REQUIRED | BUSINESS_DETAILS_REQUIRED |
  /// REPRESENTATIVE_DETAILS_REQUIRED | PAYOUT_DETAILS_REQUIRED |
  /// DOCUMENT_VERIFICATION_REQUIRED | ADDITIONAL_VERIFICATION_REQUIRED |
  /// PROVIDER_TERMS_ACCEPTANCE_REQUIRED.
  requirementCode String @db.VarChar(48)

  /// The observation instant this requirement was reported at — the same instant
  /// stamped on the account, so a requirement set is always attributable to one
  /// observation.
  observedAt DateTime @db.DateTime(3)

  // CASCADE: a requirement describes its account's current outstanding set and
  // is replaced wholesale on each observation. It is not history and must not
  // outlive the account it qualifies. The account itself is RESTRICT-protected,
  // so this never cascades from a participant delete.
  paymentAccount ParticipantPaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)

  /// The same category twice is one outstanding thing.
  @@unique([paymentAccountId, requirementCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// Versioned commercial policy and activation risk records (Phase 0M.R1).
//
// Two unrelated concerns, deliberately two model families rather than one
// generic "policy" table. They are both cross-cutting and that is their ONLY
// similarity: one describes Monacado's economics, the other describes a governed
// decision about one participant. A polymorphic table serving both would make
// every reader ask which kind of row they were holding.
//
// Four boundaries are load-bearing:
//
//   1. **The database becomes authoritative for commercial policy.** Until now
//      `MonacadoWholesaleAcquisitionPolicy` was a supplied Zod value with no home,
//      so a future Order could record a policyId/policyVersion pointing at
//      nothing. A version row is what that pair will reference.
//   2. **Policy history is immutable.** Changing economics mints a new version;
//      superseded versions keep their numbers exactly as transactions ran under
//      them. RETIRED is still bindable by historical reference — only DRAFT is not.
//   3. **No derived economics are stored.** No acquisition percentage, no
//      retained amount, no per-sale figure. They are deterministic functions of a
//      price and a version, and a stored copy is a second answer.
//   4. **RESTRICTED gains machine-readable evidence.** A restriction names a
//      member of the committed MARKETPLACE_CAPABILITIES vocabulary and a bounded
//      reason code, so the status 0M.8 refused to write now means something a
//      later reader can act on.
//
// NOT here, and belonging to 0M.R2: risk scores, classifications, reserves,
// payout holds, transaction caps, velocity windows, fraud rules, manual-review
// queues, and per-transaction policy selection. No transaction, Order, payment,
// tax, or notification model is created by this phase either.
// ─────────────────────────────────────────────────────────────────────────────

/// The enduring identity of one Monacado wholesale-acquisition policy (0M.R1).
///
/// This id is exactly what `MonacadoWholesaleAcquisitionPolicy.policyId` carries.
/// Its versions have no opaque identity of their own — they are keyed by
/// (policyId, policyVersion), the same composite the Offer source versions use,
/// so a future Order binds to a pair that cannot drift onto "whatever is current".
model CommercialPolicy {
  /// Opaque identity (mon:cpol:<opaque>). Immutable.
  id String @id @db.VarChar(191)

  /// Operational display label. NEVER an input to a calculation, never published.
  /// Economics read the id and the version and nothing else.
  label String @db.VarChar(191)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  versions CommercialPolicyVersionRow[]
}

/// One IMMUTABLE version of one commercial policy (0M.R1).
///
/// The economics columns mirror the committed
/// `MonacadoWholesaleAcquisitionPolicy` exactly — basis points for the
/// percentage, minor units for the fixed amount, an explicit currency, and the
/// rounding rule carried on the policy rather than inherited from whichever
/// calculator runs. No floating-point money anywhere.
///
/// Only `status`, `retiredAt`, and `retiredByAccountId` are ever updated, and
/// only along the DRAFT -> ACTIVE -> RETIRED path. The economics themselves are
/// never rewritten: a rate change is a new row.
model CommercialPolicyVersionRow {
  /// Surrogate key. The meaningful identity is (policyId, policyVersion).
  seq BigInt @id @default(autoincrement())

  policyId String @db.VarChar(191)

  /// The exact version label. Opaque to every calculation.
  policyVersion String @db.VarChar(64)

  /// DRAFT | ACTIVE | RETIRED. RETIRED remains bindable by historical reference —
  /// an Order that ran under it must stay reproducible. Only DRAFT is unbindable.
  status String @db.VarChar(16)

  // — Economics. Inputs only; nothing derived is stored. —
  currency                      String @db.VarChar(3)
  /// Percentage Monacado retains, in basis points (1 = 0.01%). 750 = 7.5%.
  retainedPercentageBasisPoints Int
  /// Fixed amount Monacado retains, in minor units. 100 = $1.00.
  retainedFixedAmountMinorUnits BigInt
  /// The policy carries its own rounding rule. HALF_UP_TO_MINOR_UNIT.
  roundingPolicy                String @db.VarChar(32)

  /// When this version's economics begin to apply. Supplied, never a clock read.
  effectiveFrom DateTime @db.DateTime(3)

  /// Who recorded it, as the durable internal Account id (0M.8's settled rule).
  /// Never an email address and never a display name.
  recordedByAccountId String   @db.VarChar(191)
  recordedAt          DateTime @db.DateTime(3)

  /// Set when the version leaves ACTIVE. NULL while it stands.
  retiredAt          DateTime? @db.DateTime(3)
  retiredByAccountId String?   @db.VarChar(191)

  /// Set to `policyId` while this version is ACTIVE and NULL otherwise, so the
  /// unique index below enforces AT MOST ONE ACTIVE VERSION PER POLICY while
  /// permitting any number of DRAFT and RETIRED ones. MySQL has no partial
  /// indexes; this is the same technique
  /// `ParticipantActivation.undecidedForParticipantId` uses.
  ///
  /// It is what makes "the effective policy" a question with exactly one answer,
  /// enforced by the database rather than by a service remembering to retire the
  /// incumbent first.
  activeForPolicyId String? @unique @db.VarChar(191)

  rowCreatedAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT: a policy version is the basis of historical economics. Deleting a
  // policy that holds versions must be refused.
  policy CommercialPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  /// Transaction economic snapshots recorded under THIS exact version (0M.T1).
  /// RESTRICT on the far side: a version a sale ran under is not deletable.
  transactionSnapshots TransactionEconomicSnapshot[]
  /// Orders quoted under THIS exact version (0M.9). RESTRICT.
  orders               Order[]

  /// The composite a future Order binds to. Unique, so a version label names one
  /// immutable set of numbers forever.
  @@unique([policyId, policyVersion])
  @@index([policyId, status])
  @@index([policyId, effectiveFrom])
}

/// One governed restriction on one participant (0M.R1).
///
/// The machine-readable evidence behind `MarketplaceParticipant.status =
/// RESTRICTED`, which 0M.8 refused to write for want of exactly this.
///
/// `scope` is a member of the committed MARKETPLACE_CAPABILITIES vocabulary,
/// narrowed to the commerce subset — drafting capabilities and
/// `activation:submit` are deliberately NOT restrictable, because a restriction
/// withholds commerce and never the ability to correct the work that caused it
/// (0M.1 §4.1) or to answer the restriction itself.
///
/// **A restriction is Monacado's governed decision, never an observation.** A
/// provider reporting DISABLED creates no row here; that state lives on
/// `ParticipantPaymentAccount` and stays an external fact.
///
/// There is deliberately NO column for a risk score, classification, reserve,
/// payout hold, transaction cap, velocity window, order or payment reference,
/// expiry, provider message, document, or free text. All of it is 0M.R2 or later.
model ParticipantRestriction {
  /// Opaque identity (mon:prst:<opaque>).
  id String @id @db.VarChar(191)

  participantId String @db.VarChar(191)

  /// A restrictable MARKETPLACE_CAPABILITIES member: storefront:activate |
  /// offer:publish | payout:receive | commission:accrue | review:product:submit |
  /// review:seller:submit.
  scope String @db.VarChar(48)

  /// Bounded classification, never free text and never private content.
  reasonCode String @db.VarChar(48)

  /// ACTIVE | LIFTED. LIFTED is terminal — re-imposing is a NEW restriction with
  /// its own instant and actor, so "restricted, cleared, restricted again" reads
  /// as two events rather than one row that changed its mind.
  status String @db.VarChar(16)

  imposedAt          DateTime @db.DateTime(3)
  /// The durable internal Account identity, per 0M.8's settled actor rule.
  imposedByAccountId String   @db.VarChar(191)

  liftedAt          DateTime? @db.DateTime(3)
  liftedByAccountId String?   @db.VarChar(191)
  liftedReasonCode  String?   @db.VarChar(48)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: a restriction is the evidence behind a status the participant
  // held. Deleting a participant that holds one must be refused, and lifting is
  // a state change rather than a delete, so history always survives.
  participant MarketplaceParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  /// At most ONE ACTIVE restriction per (participant, scope). Re-imposing the
  /// same scope while it already stands is a duplicate, not a second withholding.
  /// NULL-able marker column, set to the scope while ACTIVE and NULL once lifted:
  /// MySQL has no partial indexes, and this is the technique
  /// `ParticipantActivation.undecidedForParticipantId` already uses.
  activeForScope String? @db.VarChar(48)

  @@unique([participantId, activeForScope])
  @@index([participantId, status])
  @@index([status, scope])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification obligation records (Phase 0M.N1).
//
// **An obligation is the record that Monacado OWES a notice. It is not a
// message.** There is no channel, no address, no subject line, no body, no
// template, no delivery attempt, and no provider message id anywhere in this
// table — `0M.N2` owns delivery, and the separation is what makes the obligation
// durable independently of whether any channel worked.
//
// Four boundaries are load-bearing:
//
//   1. **Deduplication is a database guarantee.** The governed rule is one
//      obligation per promoter participant x exact Offer source version x change
//      category (AUTHORITATIVE_STOREFRONT_SOURCE_MODEL.md §3a). A promoter
//      carrying one Offer in five storefronts has ONE thing to decide, and five
//      notices would be five chances to miss the one that mattered.
//   2. **Recipients are participants, never addresses.** An email address is a
//      delivery destination and a mutable contact detail; keying an obligation on
//      one would hand a promoter's notices to whoever holds the address next.
//   3. **Category and subject are separate axes**, which is what makes this model
//      survive 0M.9. An order-confirmation obligation is a new category and a new
//      subject kind — not a new table, and not a column added to an Offer-shaped
//      schema.
//   4. **History is never destroyed.** Acknowledging, resolving, and archiving
//      are state changes with their own instants. ARCHIVED is not deleted.
// ─────────────────────────────────────────────────────────────────────────────

/// One durable notification obligation (0M.N1).
model NotificationObligation {
  /// Opaque identity (mon:nobl:<opaque>).
  id String @id @db.VarChar(191)

  /// WHO is owed the notice — the authoritative participant, never an address.
  recipientParticipantId String @db.VarChar(191)

  /// WHAT KIND of notice. OFFER_CHANGE is the only category with a producer in
  /// this phase; ORDER_CONFIRMATION, SALE_RECORDED, PAYMENT_FAILED,
  /// PAYOUT_STATE_CHANGED, REFUND_OR_CHARGEBACK, REVIEW_ELIGIBILITY, and
  /// OPERATIONAL_ACTION_REQUIRED are named so 0M.9 extends a vocabulary rather
  /// than migrating a schema.
  category String @db.VarChar(48)

  /// WHAT IT IS ABOUT. OFFER | ORDER | PAYMENT | PAYOUT | REVIEW.
  subjectKind String @db.VarChar(32)

  /// The domain identifier. Opaque to this model — never parsed or interpreted.
  subjectRef String @db.VarChar(191)

  /// The EXACT version, where the obligation is version-specific. An Offer-change
  /// notice is about one exact source version: a promoter who answered version 3
  /// must still be told about version 4. NULL where the subject has no version
  /// axis, which an order does not.
  subjectVersionRef String? @db.VarChar(64)

  /// Bounded sub-reason within the category. For OFFER_CHANGE this is the
  /// OfferBusinessChangeCategory the committed classifier produced — reused, so
  /// the notice and the classification can never disagree about what changed.
  /// Never free text: a context that could hold a sentence would become where the
  /// notice body lived, and then where private detail lived.
  contextCode String? @db.VarChar(48)

  /// UNREAD | ACKNOWLEDGED | RESOLVED | ARCHIVED — the four states the roadmap
  /// already names. Forward-only; ARCHIVED is terminal and is NOT a delete.
  ///
  /// ACKNOWLEDGED is informational: Storefront §3a is explicit that
  /// acknowledgement alone never reactivates a Listing, and nothing here confers
  /// any commercial effect either.
  status String @db.VarChar(16)

  /// The instant the obligation arose. Supplied, never a clock read.
  createdAt      DateTime  @db.DateTime(3)
  acknowledgedAt DateTime? @db.DateTime(3)
  resolvedAt     DateTime? @db.DateTime(3)
  archivedAt     DateTime? @db.DateTime(3)

  updatedAt DateTime @updatedAt @db.DateTime(3)

  /// The deduplication identity, derived from
  /// (recipient, category, subjectKind, subjectRef, subjectVersionRef, contextCode)
  /// by `notificationObligationKey` and never supplied by a caller.
  ///
  /// A derived key rather than a composite unique index because TWO components
  /// are nullable, and MySQL treats each NULL in a unique index as distinct — a
  /// composite index over them would silently permit exactly the duplicates this
  /// exists to prevent.
  obligationKey String @unique @db.VarChar(700)

  // RESTRICT: an obligation Monacado owes is evidence of a governed event.
  // Deleting the participant it is owed to must be refused.
  recipient MarketplaceParticipant @relation(fields: [recipientParticipantId], references: [id], onDelete: Restrict)

  /// Supplemental delivery attempts. §3a: they may accompany the notice and can
  /// never replace it, so nothing on this side reads them to decide status.
  deliveries NotificationDelivery[]

  @@index([recipientParticipantId, status, createdAt])
  @@index([category, status])
  @@index([subjectKind, subjectRef])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification delivery (Phase 1.1) — the first concrete channel.
//
// 0M.N1 recorded what Monacado OWES. This records what Monacado ATTEMPTED, and
// the two are kept strictly apart.
//
// AUTHORITATIVE_STOREFRONT_SOURCE_MODEL.md §3a is binding: "The canonical
// channel is the Monacado admin panel. Email, SMS, and push may be added later
// and are supplemental — they may accompany the notice and can never replace
// it." So a row here is EVIDENCE OF AN ATTEMPT, never an obligation. Nothing in
// the delivery path writes to NotificationObligation: a delivery neither
// satisfies, closes, nor advances one, because being emailed is not the same as
// having seen the notice in the panel.
//
// `obligationId` is NULLABLE, and that carries the phase's central decision. A
// seller or promoter is a participant and has an obligation row; a buyer — guest
// or account holder — has none, because 0M.N1 keys obligations on participants
// BY DESIGN. No participant is fabricated to satisfy this foreign key: 0M.9
// promised guest checkout creates none, and inventing one to make a notice fit
// would break that promise for the convenience of a column.
//
// THE ADDRESS IS NOT STORED. Only a SHA-256 digest of the normalised
// destination — the same construction, and the same reasoning, as 0M.9's guest
// claim code. Monacado can prove it wrote to a given address, deduplicate, and
// answer a support question, without becoming a store of buyer email addresses.
// ─────────────────────────────────────────────────────────────────────────────

/// One attempt to reach one recipient about one thing (Phase 1.1).
model NotificationDelivery {
  /// Opaque identity (mon:ndlv:<opaque>). Distinct from mon:nobl:, which names
  /// what is OWED. One obligation may have several attempts; a buyer delivery has
  /// no obligation at all. Sharing an identifier space would make "was it owed?"
  /// and "was it sent?" the same question.
  id String @id @db.VarChar(191)

  /// The 0M.N1 obligation this accompanies, where one exists.
  ///
  /// NULL for a buyer, who is not necessarily a participant and for whom no
  /// obligation is owed. Supplemental only: this row never changes the
  /// obligation's status.
  obligationId String? @db.VarChar(191)

  /// BUYER | SELLER | PROMOTER — which side of the transaction this is for.
  /// Not a role and not a capability; part of the deduplication key, so a
  /// promoter who is also a buyer receives both messages.
  audience String @db.VarChar(16)

  /// The participant addressed, or NULL for a buyer holding no participant.
  recipientParticipantId String? @db.VarChar(191)

  /// The 0M.N1 category vocabulary, reused rather than restated.
  category String @db.VarChar(48)

  /// WHAT IT IS ABOUT — mirrors the 0M.N1 subject axis so a buyer delivery,
  /// which has no obligation to inherit it from, still says what it concerned.
  subjectKind String @db.VarChar(32)
  subjectRef  String @db.VarChar(191)

  /// EMAIL. SMS and PUSH are named by §3a as future channels and are
  /// deliberately absent rather than declared-and-unimplemented.
  channel String @db.VarChar(16)

  /// Hex SHA-256 of the normalised destination. THE ADDRESS ITSELF IS NEVER
  /// STORED — there is no column for it, which is the cheapest way to keep the
  /// promise. Sufficient to prove what was written to, and to answer support.
  destinationDigest String @db.Char(64)

  /// ATTEMPTED | ACCEPTED | FAILED.
  ///
  /// ACCEPTED means the PROVIDER took responsibility — not that an inbox
  /// received it, which is the provider's to know and Monacado's to guess.
  /// A row stuck at ATTEMPTED means the process died mid-send, which is exactly
  /// what an operator should see rather than something silently retried.
  status String @db.VarChar(16)

  /// Bounded Monacado classification. NEVER a provider message, SMTP response,
  /// bounce body, or exception text — a free-text failure is where a recipient's
  /// address or a rendered body eventually lands.
  failureCode String? @db.VarChar(32)

  /// The provider's own message identifier, for correlation only. No decision is
  /// made from it.
  providerMessageRef String? @db.VarChar(191)

  attemptedAt DateTime  @db.DateTime(3)
  acceptedAt  DateTime? @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)

  /// The deduplication identity, derived from
  /// (audience, recipientParticipantId, category, subjectKind, subjectRef, channel)
  /// by `notificationDeliveryKey` and never supplied by a caller.
  ///
  /// THE DESTINATION IS DELIBERATELY NOT IN THE KEY: keying on the address would
  /// send a second receipt to a buyer who corrected their email, and would let
  /// anyone able to influence the address manufacture a duplicate send.
  deliveryKey String @unique @db.VarChar(700)

  // RESTRICT: a delivery attempt is evidence. Deleting the obligation it
  // accompanied, or the participant it was addressed to, must be refused.
  obligation NotificationObligation? @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  recipient  MarketplaceParticipant? @relation(fields: [recipientParticipantId], references: [id], onDelete: Restrict)

  @@index([status, attemptedAt])
  @@index([subjectKind, subjectRef])
  @@index([audience, category])
  @@index([recipientParticipantId, attemptedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Storefront persistence and governance (Phase 0M.3C).
//
// The missing stage between the Phase 0M.3A source model and the Phase 0M.3B
// capsule projection: an *authoritative source version* that actually exists in
// the database. Until now the projection could only ever be fed a synthetic
// fixture, because nothing could persist or retrieve a Storefront source version.
//
// The shape follows the Product precedent exactly:
//
//   Storefront                          — stable identity + current-version pointer
//   StorefrontSourceRecordVersionRow    — IMMUTABLE material snapshots
//   StorefrontGovernanceAssignment      — who administers it, additively
//
// Three boundaries are load-bearing:
//
//   1. **Immutable history.** A material change mints a new version row; no
//      historical row is ever updated. Only the stable record's pointer moves.
//   2. **Go-live approval is NOT here.** Monacado's determination that a
//      Storefront may go live is a supplied decision input (0M.3A), never a
//      Storefront fact. There is deliberately no `approvedForGoLive` column —
//      storing it would put the approver's decision inside the approved thing.
//   3. **No capsule, Node, or publication field.** This table holds transactional
//      truth; the projection derives from it one way and writes nothing back.
// ─────────────────────────────────────────────────────────────────────────────

/// Stable Monacado Storefront identity (one row per enduring storefront).
model Storefront {
  /// Opaque internal Storefront identifier (mon:storefront:<opaque>). Immutable.
  internalStorefrontId String @id @db.VarChar(191)

  /// Opaque source-record identifier (mon:srec:<opaque>), constant across all
  /// versions of this Storefront; distinct from internalStorefrontId.
  storefrontSourceRecordId String @unique @db.VarChar(191)

  /// Pointer to the current immutable version's sourceRecordVersion.
  currentSourceRecordVersion String @db.VarChar(64)

  /// The participant that owns this Storefront — the whole of ownership. No role
  /// basis accompanies it, because ownership is not role-shaped (0M.3A).
  ownerParticipantId String @db.VarChar(191)

  /// The CURRENT public routing name.
  ///
  /// Unique here and nowhere else: 0M.3A states the handle's shape but leaves
  /// uniqueness to persistence, and it is the *current* handles that must not
  /// collide. Version rows deliberately carry no unique constraint, so history
  /// preserves the handle actually authorized at each version even after the
  /// name is reassigned.
  publicHandle String @unique @db.VarChar(63)

  /// Current business state, mirrored from the current version for querying.
  /// The version row remains authoritative; this is a denormalized pointer-side
  /// copy kept in the same transaction, never an independent truth.
  lifecycle  String @db.VarChar(16)
  visibility String @db.VarChar(16)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: a Storefront anchors commercial history; deleting the owning
  // participant beneath it must be refused.
  owner MarketplaceParticipant @relation(fields: [ownerParticipantId], references: [id], onDelete: Restrict)

  versions              StorefrontSourceRecordVersionRow[]
  governanceAssignments StorefrontGovernanceAssignment[]

  // — Listing relations (Phase 0M.7). RESTRICT on the far side. Listings
  // reference Storefronts and never the reverse (0M.3A): these are Prisma's
  // required back-relations, not an embedded Listing array, and no Listing
  // column or presentation fact is added to the Storefront tables.
  listings              Listing[]
  listingSourceVersions ListingSourceRecordVersionRow[]
  /// Orders placed against Listings in this Storefront (0M.9). RESTRICT.
  orders                Order[]

  @@index([ownerParticipantId])
  @@index([lifecycle, visibility])
}

/// Immutable authoritative Storefront source-record version. Never updated in place.
///
/// A complete snapshot, not a delta — the same reasoning the Product, Offer, and
/// Listing source models record: a version that had to be replayed through its
/// predecessors would make reconstruction depend on an unbroken chain.
///
/// Every column here maps one-to-one onto a `StorefrontSourceVersion` field, so a
/// row round-trips exactly into the contract the capsule projection consumes.
model StorefrontSourceRecordVersionRow {
  /// Surrogate ordering/PK; deterministic creation order for version listing.
  seq BigInt @id @default(autoincrement())

  // — Identity and lineage —
  storefrontSourceRecordId      String  @db.VarChar(191)
  sourceRecordVersion           String  @db.VarChar(64)
  /// The version this one replaces; NULL for the first.
  supersedesSourceRecordVersion String? @db.VarChar(64)
  internalStorefrontId          String  @db.VarChar(191)

  // — Source-system identity (the existing convention) —
  sourceSystem     String @db.VarChar(64)
  sourceRecordType String @db.VarChar(64)
  sourceClass      String @db.VarChar(64)

  // — The complete material snapshot —
  ownerParticipantId String @db.VarChar(191)
  lifecycle          String @db.VarChar(16)
  visibility         String @db.VarChar(16)
  /// The handle authorized AT THIS VERSION. Not unique: history is preserved.
  publicHandle       String @db.VarChar(63)

  /// Presentation, normalized to scalars. `tagline` and `summary` are nullable
  /// rather than optional, exactly as the source contract holds them, so an
  /// absent value has one representation and cannot mint a spurious version.
  presentationDisplayName String  @db.VarChar(120)
  presentationTagline     String? @db.VarChar(200)
  presentationSummary     String? @db.Text

  // — Authorization trace —
  authorizedByParticipantId String   @db.VarChar(191)
  /// Opaque actor identifier (mon:actor:<opaque>) — never an email address or a
  /// display name, matching the remediation and activation patterns.
  authorizedByActorId       String   @db.VarChar(191)
  recordedAt                DateTime @db.DateTime(3)

  /// DB row creation time (operational; not a domain field).
  rowCreatedAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT everywhere: immutable source history is never cascade-deleted, and
  // neither the Storefront nor either referenced participant may be removed
  // beneath it.
  storefront Storefront             @relation(fields: [internalStorefrontId], references: [internalStorefrontId], onDelete: Restrict)
  owner      MarketplaceParticipant @relation("StorefrontVersionOwner", fields: [ownerParticipantId], references: [id], onDelete: Restrict)
  authorizer MarketplaceParticipant @relation("StorefrontVersionAuthorizer", fields: [authorizedByParticipantId], references: [id], onDelete: Restrict)

  /// One row per (source record, version label) — a version label is minted once.
  @@unique([storefrontSourceRecordId, sourceRecordVersion])
  @@index([internalStorefrontId, seq])
  @@index([ownerParticipantId])
  @@index([authorizedByParticipantId])
}

/// One governance assignment on one Storefront (Phase 0M.3C).
///
/// Governance is the SECOND axis 0M.3A defines: marketplace roles
/// (SELLER/PROMOTER) are the *owner's* commercial capabilities, while
/// SUPER_OWNER/ADMIN are the authority of *humans acting for* that owner.
/// Administrative authority never makes an assignee a co-owner, so this table
/// never touches `Storefront.ownerParticipantId`.
///
/// Assignments are additive, and a participant may hold at most one per
/// Storefront — appointing an already-appointed participant changes the existing
/// row rather than duplicating the grant.
model StorefrontGovernanceAssignment {
  /// Opaque identity (mon:sgov:<opaque>).
  id String @id @db.VarChar(191)

  internalStorefrontId String @db.VarChar(191)
  participantId        String @db.VarChar(191)

  /// SUPER_OWNER | ADMIN, bounded by the Zod StorefrontGovernanceRole enum.
  role String @db.VarChar(16)

  /// ACTIVE | SUSPENDED | REVOKED, bounded by the Zod enum.
  ///
  /// `NONE` is a member of the contract vocabulary but is deliberately NOT
  /// storable: it means "no assignment exists", which is the absence of a row.
  /// Persisting it would make "never appointed" and "appointed then removed"
  /// indistinguishable, which is exactly the distinction 0M.3A draws.
  status String @db.VarChar(16)

  assignedAt DateTime  @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)

  /// Set to internalStorefrontId when this row is an ACTIVE SUPER_OWNER, and
  /// NULL otherwise, so the unique index enforces **at most one active
  /// SUPER_OWNER per Storefront** while permitting many ADMINs and any number of
  /// revoked or suspended rows. MySQL has no partial indexes; this is the same
  /// technique `RegistrarReceipt.acceptedForPublicationId` and
  /// `ParticipantActivation.undecidedForParticipantId` use.
  ///
  /// The database therefore guarantees the "at most one" half of 0M.3A's
  /// exactly-one rule. The "at least one" half is a go-live readiness question,
  /// answered by the supplied `activeSuperOwnerCardinality` the contract already
  /// takes — a Storefront may legitimately exist with none while still in DRAFT.
  activeSuperOwnerForStorefrontId String? @unique @db.VarChar(191)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: a governance assignment is an authorization record. Revocation is
  // a state change, not a delete, so the appointment history survives — and a
  // participant holding one cannot be deleted beneath it.
  storefront  Storefront             @relation(fields: [internalStorefrontId], references: [internalStorefrontId], onDelete: Restrict)
  participant MarketplaceParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  /// One assignment per participant per Storefront.
  @@unique([internalStorefrontId, participantId])
  @@index([internalStorefrontId, role, status])
  @@index([participantId])
}

// ---------------------------------------------------------------------------
// Offer persistence (Phase 0M.6)
//
// The middle stage that was missing between the 0M.2A source model and the
// 0M.2B capsule projection: the immutable source *versions* that actually exist
// in the database, so a projection can be fed a persisted `OfferSourceVersion`
// rather than a synthetic fixture.
//
// The database is the sole source of truth (ADR §12). Nothing here is a capsule,
// a Node, a publication record, or a projection control. There is deliberately
// no mappingVersion, capsuleId, nodeId, contentHash, or publication state — a
// capsulization-layer control inside transactional truth is exactly what the
// 0M.2A model refuses.
//
// NOT here, and not by omission: promoter retail price, promoter spread,
// Monacado retained amount, MoR wholesale-acquisition amount, checkout tax,
// shipping, payment credentials, banking, underwriting, risk classification,
// payout holds, settlement, and every buyer datum. Those are other layers'
// facts; several are other phases' entirely.
// ---------------------------------------------------------------------------

/// Stable Offer identity and current-version pointer (Phase 0M.6).
///
/// The enduring record. Material commercial terms live on the immutable version
/// rows; this row identifies the Offer across all of them and names which one is
/// current. Business state is mirrored here for querying only — the version row
/// stays authoritative, and both move in the same transaction.
model Offer {
  /// Opaque internal Offer identifier (mon:offer:<opaque>). Immutable, and never
  /// an AgentNet Node: `mon:offer:` is internal and a Node is issued elsewhere.
  internalOfferId String @id @db.VarChar(191)

  /// Opaque source-record identifier (mon:srec:<opaque>), constant across every
  /// version of this Offer; distinct from internalOfferId. The same convention
  /// the Product and Storefront source records already use.
  offerSourceRecordId String @unique @db.VarChar(191)

  /// Pointer to the current immutable version's sourceRecordVersion.
  currentSourceRecordVersion String @db.VarChar(64)

  /// The Product these commercial terms are for. An Offer names a Product; it
  /// restates no Product descriptive fact (ADR §2 authority partitioning).
  internalProductId String @db.VarChar(191)

  /// The participant holding Seller authority. A TRANSACTIONAL identity — never
  /// a Creator Node and never any public semantic identity (0M.2A §3).
  sellerParticipantId String @db.VarChar(191)

  /// Current business state, mirrored from the current version for querying.
  /// Denormalized pointer-side copies kept in the same transaction, never an
  /// independent truth. `availability` needs 23 characters for
  /// TEMPORARILY_UNAVAILABLE.
  lifecycle    String @db.VarChar(16)
  availability String @db.VarChar(32)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT everywhere: an Offer is a standing commercial commitment. Deleting
  // the Product it is for, or the participant that authored it, must be refused
  // rather than silently erasing what a seller offered.
  product Product                @relation(fields: [internalProductId], references: [internalProductId], onDelete: Restrict)
  seller  MarketplaceParticipant @relation("OfferSeller", fields: [sellerParticipantId], references: [id], onDelete: Restrict)

  versions OfferSourceRecordVersionRow[]

  /// Promoted Listing versions that name this Offer (0M.7). RESTRICT.
  promotedListingVersions ListingSourceRecordVersionRow[] @relation("ListingAcceptedOffer")

  /// Transaction economic snapshots for promoted sales of this Offer (0M.T1). RESTRICT.
  transactionSnapshots TransactionEconomicSnapshot[]

  @@index([internalProductId])
  @@index([sellerParticipantId])
  @@index([lifecycle, availability])
}

/// Immutable authoritative Offer source-record version. Never updated in place.
///
/// A complete snapshot, not a delta — the same reasoning 0M.2A records: a
/// version that had to be replayed through its predecessors would make
/// deterministic reconstruction depend on an unbroken chain, and one missing
/// link would lose every version after it.
///
/// Every column maps one-to-one onto an `OfferSourceVersion` field, so a row
/// round-trips exactly into the contract `projectOfferCapsule` already consumes.
///
/// This is the durable identity a 0M.7 promoted Listing binds to: the
/// `(offerSourceRecordId, sourceRecordVersion)` unique key names one exact
/// accepted version, with no dependence on mutable current state, a capsule
/// hash, external publication, or an in-memory fixture.
model OfferSourceRecordVersionRow {
  /// Surrogate ordering/PK; deterministic creation order for version listing.
  seq BigInt @id @default(autoincrement())

  // — Identity and lineage —
  offerSourceRecordId           String  @db.VarChar(191)
  sourceRecordVersion           String  @db.VarChar(64)
  /// The version this one replaces; NULL for the first.
  supersedesSourceRecordVersion String? @db.VarChar(64)
  internalOfferId               String  @db.VarChar(191)

  // — Source-system identity (the existing convention) —
  sourceSystem     String @db.VarChar(64)
  sourceRecordType String @db.VarChar(64)
  sourceClass      String @db.VarChar(64)

  // — The complete material snapshot —
  internalProductId   String @db.VarChar(191)
  sellerParticipantId String @db.VarChar(191)
  lifecycle           String @db.VarChar(16)
  availability        String @db.VarChar(32)

  // — Commercial terms, normalized to scalars —
  //
  // `terms.price` and `terms.promotion` are discriminated unions, flattened here
  // so every member is a typed column rather than a JSON blob. The discriminator
  // columns are NOT NULL and the arms are nullable: a FREE Offer has NO
  // wholesale amount and NO currency, which is absence by construction in the
  // contract and NULL columns here. The mapper rebuilds the union from the
  // discriminator, so an arm value can never be read under the wrong arm.

  /// FREE | PAID.
  priceType String @db.VarChar(8)

  /// PAID only. What the CREATOR is owed before promoter commission — never what
  /// a buyer pays. BIGINT because minor units are integers up to
  /// Number.MAX_SAFE_INTEGER; the mapper refuses anything outside that range.
  wholesalePriceMinorUnits BigInt?
  /// PAID only. Three uppercase letters (structural; not an ISO 4217 registry).
  wholesalePriceCurrency   String? @db.VarChar(3)

  /// NOT_PROMOTABLE | PROMOTABLE.
  promotionType String @db.VarChar(16)

  /// PROMOTABLE only. PERCENT_OF_WHOLESALE | FIXED_AMOUNT. The commission basis
  /// is ALWAYS the wholesale price: a retail-derived basis is refused by the
  /// contract, because a promoter could otherwise change what the creator owes.
  commissionMethod          String? @db.VarChar(24)
  /// PERCENT_OF_WHOLESALE only. Basis points: 1 = 0.01%, 10000 = 100%.
  commissionBasisPoints     Int?
  /// FIXED_AMOUNT only.
  fixedCommissionMinorUnits BigInt?
  fixedCommissionCurrency   String? @db.VarChar(3)

  // — Effective interval —
  //
  // Two nullable columns are EXACTLY sufficient, with no ambiguity: the contract
  // refuses an interval whose bounds are both null, so both-NULL here means "no
  // effective interval" and nothing else. There is one representation per fact,
  // which is what stops a spurious material change.
  effectiveStartsAt DateTime? @db.DateTime(3)
  effectiveEndsAt   DateTime? @db.DateTime(3)

  // — Accepted economics —
  //
  // Stored, not recomputed on read. 0M.2A requires the exact numbers the creator
  // was shown to be reproducible rather than recalculated under whatever policy
  // is current later. The contract re-checks them against the deterministic
  // calculator on the way out, so a drifted row fails loudly.
  calculatedCommissionMinorUnits           BigInt
  calculatedCreatorGrossProceedsMinorUnits BigInt
  commissionCalculationPolicyVersion       String @db.VarChar(48)

  // — Authorization trace —
  authorizedBySellerParticipantId String   @db.VarChar(191)
  /// Opaque actor identifier (mon:actor:<opaque>) — never an email address or a
  /// display name, matching the activation and Storefront patterns.
  authorizedByActorId             String   @db.VarChar(191)
  recordedAt                      DateTime @db.DateTime(3)

  /// DB row creation time (operational; not a domain field).
  rowCreatedAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT everywhere: immutable source history is never cascade-deleted, and
  // neither the Offer, the Product, nor either referenced participant may be
  // removed beneath it.
  offer      Offer                  @relation(fields: [internalOfferId], references: [internalOfferId], onDelete: Restrict)
  product    Product                @relation(fields: [internalProductId], references: [internalProductId], onDelete: Restrict)
  seller     MarketplaceParticipant @relation("OfferVersionSeller", fields: [sellerParticipantId], references: [id], onDelete: Restrict)
  authorizer MarketplaceParticipant @relation("OfferVersionAuthorizer", fields: [authorizedBySellerParticipantId], references: [id], onDelete: Restrict)

  /// Promoted Listing versions that accepted THIS exact Offer version (0M.7).
  /// RESTRICT on the far side: an accepted version is a term a promoter agreed
  /// to, and it must not be deletable while a Listing still depends on it.
  acceptingListingVersions ListingSourceRecordVersionRow[] @relation("ListingAcceptedOfferVersion")

  /// Transaction economic snapshots whose wholesale economics came from THIS
  /// exact version (0M.T1). RESTRICT: a completed sale's basis is not deletable.
  transactionSnapshots TransactionEconomicSnapshot[]

  /// One row per (source record, version label) — a version label is minted
  /// once. This is the durable key a 0M.7 Listing binds an exact Offer version by.
  @@unique([offerSourceRecordId, sourceRecordVersion])
  @@index([internalOfferId, seq])
  @@index([internalProductId])
  @@index([sellerParticipantId])
  @@index([authorizedBySellerParticipantId])
}

// ---------------------------------------------------------------------------
// Listing persistence (Phase 0M.7)
//
// The last missing middle stage: the immutable source *versions* behind the
// 0M.4A Listing source model, so the 0M.4B projection can be fed a persisted
// `ListingSourceVersion` rather than a synthetic fixture.
//
// The database is the sole source of truth (ADR §12). Nothing here is a capsule,
// a Node, a publication record, or a projection control.
//
// DERIVED VALUES ARE NOT STORED, and this is the rule that shapes the tables.
// 0M.4A is explicit that effective seller price, sale-active status, Monacado's
// retained amount, the MoR wholesale-acquisition amount, seller proceeds,
// promoter spread, promoter net proceeds, promoter margin rate, minimum viable
// retail, and buyer-active eligibility are all COMPUTED from authoritative
// inputs plus a supplied instant and a supplied policy. A stored copy is a
// second answer that can disagree with the first — and a stored effective price
// would additionally mean a Listing needed a database write every time a sale
// window opened or closed. There is no column for any of them.
//
// Tax, VAT, GST, shipping, freight, and delivery are outside every basis 0M.4A
// defines, and there is no column for any of them either.
// ---------------------------------------------------------------------------

/// Stable Listing identity and current-version pointer (Phase 0M.7).
///
/// The buyer-facing placement of a Product in a Storefront, as either a
/// seller-controlled direct sale or a promoter-controlled resale under an Offer.
model Listing {
  /// Opaque internal Listing identifier (mon:listing:<opaque>). Immutable, and
  /// never an AgentNet Node.
  internalListingId String @id @db.VarChar(191)

  /// Opaque source-record identifier (mon:srec:<opaque>), constant across every
  /// version of this Listing; distinct from internalListingId.
  listingSourceRecordId String @unique @db.VarChar(191)

  /// Pointer to the current immutable version's sourceRecordVersion.
  currentSourceRecordVersion String @db.VarChar(64)

  /// SELLER_DIRECT | PROMOTED. Denormalized from the current version for
  /// querying; the version row stays authoritative.
  listingType String @db.VarChar(16)

  /// The placement's three authoritative references.
  internalProductId        String @db.VarChar(191)
  storefrontId             String @db.VarChar(191)
  /// The participant who controls this Listing — the seller for SELLER_DIRECT,
  /// the promoter for PROMOTED. One neutral participant identity with additive
  /// roles (0M.5); there is no Seller table and no Promoter table.
  controllingParticipantId String @db.VarChar(191)

  /// Current lifecycle, mirrored from the current version for querying. Moves
  /// with the pointer in the same transaction, never independently.
  lifecycle String @db.VarChar(16)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT everywhere: a Listing is a buyer-facing commercial placement.
  // Deleting the Product, the Storefront, or the controlling participant
  // beneath it must be refused rather than silently erasing the placement.
  product    Product                @relation(fields: [internalProductId], references: [internalProductId], onDelete: Restrict)
  storefront Storefront             @relation(fields: [storefrontId], references: [internalStorefrontId], onDelete: Restrict)
  controller MarketplaceParticipant @relation("ListingController", fields: [controllingParticipantId], references: [id], onDelete: Restrict)

  versions ListingSourceRecordVersionRow[]

  /// Transaction economic snapshots recorded against this Listing (0M.T1). RESTRICT.
  transactionSnapshots TransactionEconomicSnapshot[]
  /// Orders placed against this Listing (0M.9). RESTRICT.
  orders               Order[]

  @@index([internalProductId])
  @@index([storefrontId])
  @@index([controllingParticipantId])
  @@index([listingType, lifecycle])
}

/// Immutable authoritative Listing source-record version. Never updated in place.
///
/// A complete snapshot, not a delta. Every column maps one-to-one onto a
/// `ListingSourceVersion` field, so a row round-trips exactly into the contract
/// `listingSourceRecordToCapsuleProjection` already consumes.
///
/// THE DISCRIMINATED UNION IS PRESERVED, NOT COLLAPSED. `listingType` is the
/// discriminator; each branch's fields are nullable columns read only when the
/// discriminator selects them. 0M.4A makes the two branches structurally
/// impossible to confuse — a SELLER_DIRECT placement has no field for an Offer
/// dependency and a PROMOTED placement has no field for a scheduled sale — and
/// the mapper rebuilds the union from the discriminator so neither can acquire
/// the other's fields on the way out.
model ListingSourceRecordVersionRow {
  /// Surrogate ordering/PK; deterministic creation order for version listing.
  seq BigInt @id @default(autoincrement())

  // — Identity and lineage —
  listingSourceRecordId         String  @db.VarChar(191)
  sourceRecordVersion           String  @db.VarChar(64)
  /// The version this one replaces; NULL for the first.
  supersedesSourceRecordVersion String? @db.VarChar(64)
  internalListingId             String  @db.VarChar(191)

  // — Source-system identity (the existing convention) —
  sourceSystem     String @db.VarChar(64)
  sourceRecordType String @db.VarChar(64)
  sourceClass      String @db.VarChar(64)

  // — The complete material snapshot —
  storefrontId             String @db.VarChar(191)
  internalProductId        String @db.VarChar(191)
  controllingParticipantId String @db.VarChar(191)
  lifecycle                String @db.VarChar(16)

  /// The union discriminator. NOT NULL: every placement is one branch or the other.
  listingType String @db.VarChar(16)

  /// The ordinary commercial retail price — the merchandise price alone. Both
  /// branches carry one. BIGINT because minor units are integers up to
  /// Number.MAX_SAFE_INTEGER. Tax and shipping are NOT part of it and have no
  /// column anywhere.
  retailPriceMinorUnits BigInt
  retailPriceCurrency   String @db.VarChar(3)

  // — SELLER_DIRECT arm: the optional scheduled sale —
  //
  // All four columns are all-present or all-NULL, mirroring the contract's
  // single nested object: there is no way to record a start without a price.
  // The ordinary retail price above is never overwritten when a sale runs, so
  // the price to return to still exists when the window closes.
  //
  // Timing is UTC, START INCLUSIVE and END EXCLUSIVE, stored as instants. No
  // currentPrice, effectivePrice, pricedAt, or saleIsActive column exists: those
  // are derived from these columns plus a supplied instant, which is why a sale
  // starting or ending requires no database write.
  salePriceMinorUnits BigInt?
  salePriceCurrency   String?   @db.VarChar(3)
  saleStartsAt        DateTime? @db.DateTime(3)
  saleEndsAt          DateTime? @db.DateTime(3)

  // — PROMOTED arm: the exact accepted Offer source version —
  //
  // Not a copy of the Offer. The identity, the EXACT version, and the economics
  // actually accepted — enough to reconstruct what the promoter agreed to and to
  // detect that the upstream Offer has moved past it. The Offer source version
  // remains authoritative for wholesale economics; these are the terms accepted,
  // not a second answer to them.
  acceptedInternalOfferId                    String?   @db.VarChar(191)
  acceptedOfferSourceRecordId                String?   @db.VarChar(191)
  /// The EXACT version accepted — never "current", never "latest".
  acceptedOfferSourceRecordVersion           String?   @db.VarChar(64)
  acceptedWholesalePriceMinorUnits           BigInt?
  acceptedWholesalePriceCurrency             String?   @db.VarChar(3)
  acceptedCommissionCalculationPolicyVersion String?   @db.VarChar(64)
  acceptedAt                                 DateTime? @db.DateTime(3)
  /// NO_UPSTREAM_CHANGE | REVIEW_REQUIRED | ACCEPTED_CURRENT_VERSION.
  upstreamReviewState                        String?   @db.VarChar(32)

  // — Authorization trace —
  authorizedByParticipantId String   @db.VarChar(191)
  /// Opaque actor identifier (mon:actor:<opaque>) — never an email address or a
  /// display name.
  authorizedByActorId       String   @db.VarChar(191)
  recordedAt                DateTime @db.DateTime(3)

  /// DB row creation time (operational; not a domain field).
  rowCreatedAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT everywhere: immutable source history is never cascade-deleted.
  listing    Listing                @relation(fields: [internalListingId], references: [internalListingId], onDelete: Restrict)
  product    Product                @relation(fields: [internalProductId], references: [internalProductId], onDelete: Restrict)
  storefront Storefront             @relation(fields: [storefrontId], references: [internalStorefrontId], onDelete: Restrict)
  controller MarketplaceParticipant @relation("ListingVersionController", fields: [controllingParticipantId], references: [id], onDelete: Restrict)
  authorizer MarketplaceParticipant @relation("ListingVersionAuthorizer", fields: [authorizedByParticipantId], references: [id], onDelete: Restrict)

  /// The stable Offer named by a promoted placement. NULL for SELLER_DIRECT.
  acceptedOffer Offer? @relation("ListingAcceptedOffer", fields: [acceptedInternalOfferId], references: [internalOfferId], onDelete: Restrict)

  /// THE EXACT ACCEPTED OFFER SOURCE VERSION.
  ///
  /// A composite foreign key onto `OfferSourceRecordVersionRow`'s
  /// (offerSourceRecordId, sourceRecordVersion) unique key — the durable
  /// identity 0M.6 established. This is the requirement of the whole promoted
  /// branch made structural:
  ///
  ///   - a promoted Listing CANNOT reference an Offer version that does not
  ///     exist, because the database refuses the row;
  ///   - the accepted version CANNOT be deleted while a Listing depends on it,
  ///     because the rule is RESTRICT;
  ///   - the binding NEVER follows the Offer's current-version pointer, because
  ///     it names a version label rather than reading the stable Offer row.
  ///
  /// Both columns are NULL for SELLER_DIRECT, and MySQL's MATCH SIMPLE
  /// semantics let a composite FK pass when any column is NULL — so the branch
  /// that has no Offer is unconstrained by it.
  acceptedOfferVersion OfferSourceRecordVersionRow? @relation("ListingAcceptedOfferVersion", fields: [acceptedOfferSourceRecordId, acceptedOfferSourceRecordVersion], references: [offerSourceRecordId, sourceRecordVersion], onDelete: Restrict)

  /// Transaction economic snapshots whose retail price came from THIS exact
  /// version (0M.T1). RESTRICT: the terms a completed sale ran under endure.
  transactionSnapshots TransactionEconomicSnapshot[]
  /// Orders that bought THIS exact version's terms (0M.9). RESTRICT: the terms
  /// a completed purchase ran under endure.
  orders               Order[]

  /// One row per (source record, version label) — a version label is minted once.
  @@unique([listingSourceRecordId, sourceRecordVersion])
  @@index([internalListingId, seq])
  @@index([internalProductId])
  @@index([storefrontId])
  @@index([controllingParticipantId])
  @@index([authorizedByParticipantId])
  @@index([acceptedInternalOfferId])
  @@index([acceptedOfferSourceRecordId, acceptedOfferSourceRecordVersion])
}

// ---------------------------------------------------------------------------
// MoR transaction accounting foundation (Phase 0M.T1)
//
// The immutable per-sale economic snapshot `0M.9` writes its first real Order
// and payment against. Monacado must not create a transactional payment record
// it cannot account for.
//
// TWO TABLES, AND THE SPLIT IS THE POINT. `TransactionEconomicSnapshot` holds
// economic facts and is NEVER updated in place — no service operation writes to
// it after the insert. `TransactionSettlement` holds the things that
// legitimately move: where the money got to, and what the provider called it.
// Keeping them apart is what makes "economic facts are not editable" enforceable
// rather than aspirational, because recording provider evidence targets a
// different table from the one holding what the parties earned.
//
// THE BINDING IS STRUCTURAL. Three composite foreign keys onto the unique keys
// 0M.6, 0M.7, and 0M.R1 already established:
//   (listingSourceRecordId, listingSourceRecordVersion) -> ListingSourceRecordVersionRow
//   (offerSourceRecordId,   offerSourceRecordVersion)   -> OfferSourceRecordVersionRow
//   (policyId,              policyVersion)              -> CommercialPolicyVersionRow
// A snapshot cannot name a version that does not exist, none of them can be
// deleted beneath it (RESTRICT), and every binding names a version LABEL rather
// than following a current-version pointer — so historical economics do not move
// when a Listing, an Offer, or the current policy does.
//
// TAX AND SHIPPING ARE OUTSIDE THE COMMERCIAL BASIS. Their amounts are recorded
// so a future checkout can state a buyer's total; they enter no retention, no
// acquisition, no commission, and no promoter margin. There is deliberately NO
// column for a tax rate, jurisdiction, nexus finding, taxability class, or
// remittance state — 0M.T2 owns tax execution.
//
// NO ORDER, NO CHECKOUT, NO PAYMENT EXECUTION, NO PAYOUT, NO REFUND, AND NO
// CHARGEBACK exists here. 0M.9 mints the Order and binds one to a snapshot with
// an additive nullable column; 0M.T2 owns reversal accounting.
// ---------------------------------------------------------------------------

/// One IMMUTABLE per-sale economic snapshot (0M.T1).
///
/// Written once and never updated. The discriminated union is preserved rather
/// than collapsed: `transactionType` is the discriminator, and the promoted arm's
/// columns are NULL for SELLER_DIRECT — a seller selling their own product has no
/// promoter counterparty, and a zero would imply one who earned nothing rather
/// than one who does not exist.
model TransactionEconomicSnapshot {
  /// Opaque identity (mon:txsnp:<opaque>). Not a Node, not a capsule identity,
  /// never published: what any party earned on a sale is nobody's business but
  /// the counterparties'.
  id String @id @db.VarChar(191)

  /// SELLER_DIRECT | PROMOTED. Read from the bound Listing source version, never
  /// supplied, so it cannot disagree with the placement that produced it.
  transactionType String @db.VarChar(16)

  // — Exact Listing binding —
  internalListingId          String @db.VarChar(191)
  listingSourceRecordId      String @db.VarChar(191)
  /// The EXACT version label — never "current", never "latest".
  listingSourceRecordVersion String @db.VarChar(64)

  // — Exact Offer binding. PROMOTED only; NULL for SELLER_DIRECT. —
  internalOfferId          String? @db.VarChar(191)
  offerSourceRecordId      String? @db.VarChar(191)
  /// The EXACT version label the wholesale economics came from.
  offerSourceRecordVersion String? @db.VarChar(64)

  // — Exact commercial policy binding —
  policyId      String @db.VarChar(191)
  /// The EXACT version — never the effective one. A RETIRED version resolves
  /// normally, which is the whole point of 0M.R1's immutable version history.
  policyVersion String @db.VarChar(64)

  // — Commercial retail economics. BIGINT minor units; no floating-point money. —
  //
  // The effective price at `occurredAt`, so a seller-direct sale inside a
  // scheduled window records the sale price. Tax and shipping are NOT in it.
  currency                         String @db.VarChar(3)
  commercialRetailAmountMinorUnits BigInt

  monacadoRetainedAmountMinorUnits        BigInt
  morWholesaleAcquisitionAmountMinorUnits BigInt
  /// SELLER_DIRECT: the whole acquisition amount. PROMOTED: offer wholesale less
  /// the seller-funded commission — the seller's own contracted proceeds.
  sellerProceedsMinorUnits                BigInt

  // — PROMOTED arm. NULL for SELLER_DIRECT. —
  //
  // `offerWholesalePriceMinorUnits` is what the SELLER contracted to be owed;
  // `morWholesaleAcquisitionAmountMinorUnits` above is what MONACADO paid the
  // supply side out of retail. Different economic layers, never the same name.
  offerWholesalePriceMinorUnits    BigInt?
  sellerFundedCommissionMinorUnits BigInt?
  /// acquisition - offerWholesale. SIGNED: 0M.4A permits a negative spread so
  /// long as promoter NET proceeds are not negative.
  promoterRetailSpreadMinorUnits   BigInt?
  /// spread + commission. The authoritative promoter figure.
  promoterNetProceedsMinorUnits    BigInt?

  // — Outside the commercial economics (business model §G/§H) —
  //
  // Amounts only. Recorded so a future checkout can state the buyer's total;
  // they enter no basis. There is no tax rate, jurisdiction, nexus, taxability
  // class, exemption, carrier, service level, or remittance column — 0M.T2.
  taxAmountMinorUnits              BigInt
  shippingAmountMinorUnits         BigInt
  otherPassThroughAmountMinorUnits BigInt

  /// The instant of sale the economics were computed at. Supplied, never a clock read.
  occurredAt DateTime @db.DateTime(3)
  recordedAt DateTime @db.DateTime(3)

  /// DB row creation time (operational; not a domain field).
  rowCreatedAt DateTime @default(now()) @db.DateTime(3)

  // RESTRICT everywhere: a snapshot is the record every party's entitlement
  // reconciles against. Nothing it binds to may be deleted beneath it.
  listing          Listing                       @relation(fields: [internalListingId], references: [internalListingId], onDelete: Restrict)
  listingVersion   ListingSourceRecordVersionRow @relation(fields: [listingSourceRecordId, listingSourceRecordVersion], references: [listingSourceRecordId, sourceRecordVersion], onDelete: Restrict)
  offer            Offer?                        @relation(fields: [internalOfferId], references: [internalOfferId], onDelete: Restrict)
  /// Both columns NULL for SELLER_DIRECT; MySQL MATCH SIMPLE lets a composite FK
  /// pass when any column is NULL, so the branch with no Offer is unconstrained.
  offerVersion     OfferSourceRecordVersionRow?  @relation(fields: [offerSourceRecordId, offerSourceRecordVersion], references: [offerSourceRecordId, sourceRecordVersion], onDelete: Restrict)
  policyVersionRow CommercialPolicyVersionRow    @relation(fields: [policyId, policyVersion], references: [policyId, policyVersion], onDelete: Restrict)

  /// The Order this sale completed (0M.9) — the ADDITIVE NULLABLE COLUMN 0M.T1
  /// anticipated, so binding an Order was a migration rather than a rewrite.
  /// UNIQUE: one snapshot per Order and one Order per snapshot. Nullable because
  /// the column is additive over rows written before 0M.9 existed; every snapshot
  /// this phase writes sets it inside the same transaction that marks the Order PAID.
  orderId String? @unique @db.VarChar(191)

  /// RESTRICT: the Order a sale's economics belong to is never deleted.
  order Order? @relation("OrderEconomics", fields: [orderId], references: [id], onDelete: Restrict)

  settlement TransactionSettlement?

  /// What was given back on this sale, if anything (Phase 1.2).
  ///
  /// At most one, and a SEPARATE immutable record — this snapshot is not edited,
  /// gains no reversed-* column, and still has no update path. The net position
  /// is snapshot MINUS reversal, derived and stored nowhere.
  reversal            TransactionReversal?
  proceedsObligations ProceedsObligation[]

  @@index([internalListingId, occurredAt])
  @@index([listingSourceRecordId, listingSourceRecordVersion])
  @@index([offerSourceRecordId, offerSourceRecordVersion])
  @@index([policyId, policyVersion])
  @@index([transactionType, occurredAt])
}

/// Where the money for one snapshot has got to (0M.T1).
///
/// THE MUTABLE HALF, kept deliberately apart from the immutable economics. Every
/// legitimate update targets this table; the snapshot table has no update path
/// at all, so provider evidence arriving can never rewrite what the parties
/// earned.
///
/// Provider-neutral by construction. Four states and no more, none of them
/// provider-shaped: no `charges_enabled`, no balance, no transfer, no payout, no
/// schedule. REVERSED records only that the funds movement was undone — there is
/// NO reversal amount, no partial reversal, no recovery from seller or promoter
/// economics, and no refund/chargeback distinction. That accounting is 0M.T2 and
/// will be its own entry rather than an edit to this one.
model TransactionSettlement {
  /// One settlement row per snapshot; the snapshot's identity IS the key.
  snapshotId String @id @db.VarChar(191)

  /// PENDING | FUNDS_RECEIVED | SETTLED | REVERSED.
  state String @db.VarChar(24)

  /// The provider counterparty, from the committed 0M.8 vocabulary. NULL until
  /// provider evidence exists, and always set together with the reference below:
  /// a reference without its counterparty is unreconcilable.
  provider String? @db.VarChar(32)

  /// An OPAQUE EXTERNAL identifier for the transaction at the provider. Not a
  /// Node, not a capsule identity, not public identity, never published, and
  /// never a credential — the contract refuses `mon:` forms and provider-secret
  /// prefixes. Monacado's economics are never inferred from it.
  providerTransactionRef      String?   @db.VarChar(191)
  providerReferenceRecordedAt DateTime? @db.DateTime(3)

  fundsReceivedAt DateTime? @db.DateTime(3)
  settledAt       DateTime? @db.DateTime(3)
  reversedAt      DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: settlement standing is evidence about a financial record. The
  // snapshot beneath it is never deleted.
  snapshot TransactionEconomicSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  /// One provider transaction maps to AT MOST ONE Monacado snapshot, so the same
  /// provider charge cannot be recorded against two sales. MySQL treats each NULL
  /// in a unique index as distinct, so unreferenced rows are unconstrained.
  @@unique([provider, providerTransactionRef])
  @@index([state])
}

// ---------------------------------------------------------------------------
// Buyer checkout, Order, and post-sale foundation (Phase 0M.9)
//
// The first phase that creates an actual commercial transaction. Four tables,
// each answering one question a completed sale raises:
//
//   Order                    — who bought, what they were quoted, where the
//                              payment got to.
//   ProceedsObligation       — what Monacado owes the seller and any promoter.
//   PurchaseEvidence         — the PRIVATE record that a buyer transacted.
//   ReviewSubmissionAuthority— the stored grant ADR §11.6 requires before
//                              Monacado publishes a review for anyone.
//
// AN ORDER IS NOT AN ECONOMIC SNAPSHOT. What the sale EARNED each party lives on
// `TransactionEconomicSnapshot` (0M.T1) and nowhere else; the Order records the
// QUOTE, which must exist before any payment runs and therefore before any
// snapshot can. The two are bound one-to-one by the additive nullable
// `orderId` column on the snapshot — exactly the migration 0M.T1 anticipated —
// and the successful-sale path asserts the quote equals the snapshot's amounts.
//
// NO BUYER PERSONAL DATA ANYWHERE. There is no column for an email, a name, a
// postal address, an IP address, a card detail, or a device on any table here. A
// guest is bound to their purchase by a one-way claim-code DIGEST, on the same
// terms as a session token: the raw code is returned once and never stored.
// Guest checkout creates no Account and fabricates no MarketplaceParticipant.
//
// SETTLEMENT IS NOT RESTATED. Where the FUNDS got to — captured, settled,
// reversed — is 0M.T1's `TransactionSettlement`. Two lifecycles over one sale
// would be two answers to one question.
//
// NO PAYOUT EXECUTION, NO REFUND, NO CHARGEBACK, NO TAX CALCULATION, AND NO
// PROVIDER INTEGRATION. Obligations record what is owed; 0M.T2 owns reversal
// accounting; the payment adapter behind `BuyerPaymentPort` does not exist.
// ---------------------------------------------------------------------------

/// One buyer Order (0M.9).
///
/// The buyer branch is a discriminated union preserved rather than collapsed:
/// `buyerKind` is the discriminator, an ACCOUNT_BUYER carries `buyerAccountId`
/// and no claim digest, and a GUEST_BUYER carries a claim digest and no account.
/// The mapper rebuilds the union from the discriminator, so neither branch can
/// acquire the other's fields on the way out.
model Order {
  /// Opaque identity (mon:order:<opaque>). Not a Node, not a capsule identity,
  /// never published — buyer identity is not published by default (ADR §11.10).
  id String @id @db.VarChar(191)

  /// ACCOUNT_BUYER | GUEST_BUYER. Guest is first-class, not a degraded account.
  buyerKind String @db.VarChar(16)

  /// NULL for a guest. RESTRICT: an account that has bought something is not
  /// deletable out from under its own purchase history.
  buyerAccountId String? @db.VarChar(191)

  /// NULL unless this account already held a participant record at checkout.
  /// Buying requires no participant, no role, and no activation — those gate
  /// SELLING. A guest NEVER gets one fabricated.
  buyerParticipantId String? @db.VarChar(191)

  /// GUEST ONLY. Hex SHA-256 of the claim code handed to the buyer once, at
  /// checkout. The raw code is never stored, so a database disclosure yields no
  /// means of claiming anybody's purchase. UNIQUE so one code claims one Order.
  guestClaimCodeDigest String? @unique @db.VarChar(64)

  /// Set when a guest purchase is later attached to an account. `buyerKind`
  /// stays GUEST_BUYER forever: the sale was made by a guest, and a record that
  /// quietly became an account purchase would misstate what happened.
  claimedByAccountId String?   @db.VarChar(191)
  claimedAt          DateTime? @db.DateTime(3)

  // — Exact Listing binding —
  internalListingId          String @db.VarChar(191)
  listingSourceRecordId      String @db.VarChar(191)
  /// The EXACT version bought — never "current", never "latest". The snapshot
  /// created from this Order binds the identical version.
  listingSourceRecordVersion String @db.VarChar(64)

  // — Exact commercial policy binding —
  policyId      String @db.VarChar(191)
  policyVersion String @db.VarChar(64)

  // — Operational references —
  storefrontId      String @db.VarChar(191)
  internalProductId String @db.VarChar(191)

  // — Counterparties —
  /// SELLER_DIRECT | PROMOTED, read from the bound Listing source version.
  transactionType       String  @db.VarChar(16)
  /// The party owed seller proceeds. For a PROMOTED sale this is the OFFER's
  /// seller, who is not the Listing's controller.
  sellerParticipantId   String  @db.VarChar(191)
  /// PROMOTED only; NULL for seller-direct, where no promoter exists.
  promoterParticipantId String? @db.VarChar(191)

  // — The quote. NOT economics. —
  //
  // What the buyer was TOLD they would be charged, named `quoted*` so nobody can
  // mistake it for the settled split. The successful-sale path asserts each of
  // these equals the corresponding snapshot figure, so the overlap is a CHECKED
  // INVARIANT rather than a second answer left to drift.
  //
  // The buyer's TOTAL is derived from these four and is deliberately not stored.
  currency                               String @db.VarChar(3)
  /// The merchandise price alone — the effective price at checkout time, so a
  /// scheduled sale window quotes the sale price. Tax and shipping are NOT in it.
  quotedCommercialRetailAmountMinorUnits BigInt
  /// Supplied by the caller and calculated by nothing here. 0M.T2 owns tax.
  quotedTaxAmountMinorUnits              BigInt
  quotedShippingAmountMinorUnits         BigInt
  quotedOtherPassThroughAmountMinorUnits BigInt

  // — Lifecycle —
  /// PENDING_PAYMENT | PAID | PAYMENT_FAILED | CANCELLED. Where the FUNDS got to
  /// afterwards is 0M.T1's settlement record, not restated here.
  lifecycle          String  @db.VarChar(24)
  /// Set only in PAYMENT_FAILED. A bounded Monacado classification — never a
  /// provider decline message, issuer reason, or network code.
  paymentFailureCode String? @db.VarChar(32)

  placedAt    DateTime  @db.DateTime(3)
  paidAt      DateTime? @db.DateTime(3)
  failedAt    DateTime? @db.DateTime(3)
  cancelledAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT everywhere: an Order is a commercial transaction. Nothing it binds
  // to may be deleted beneath it.
  buyerAccount     Account?                      @relation("OrderBuyerAccount", fields: [buyerAccountId], references: [id], onDelete: Restrict)
  claimedByAccount Account?                      @relation("OrderClaimedByAccount", fields: [claimedByAccountId], references: [id], onDelete: Restrict)
  buyerParticipant MarketplaceParticipant?       @relation("OrderBuyerParticipant", fields: [buyerParticipantId], references: [id], onDelete: Restrict)
  listing          Listing                       @relation(fields: [internalListingId], references: [internalListingId], onDelete: Restrict)
  listingVersion   ListingSourceRecordVersionRow @relation(fields: [listingSourceRecordId, listingSourceRecordVersion], references: [listingSourceRecordId, sourceRecordVersion], onDelete: Restrict)
  policyVersionRow CommercialPolicyVersionRow    @relation(fields: [policyId, policyVersion], references: [policyId, policyVersion], onDelete: Restrict)
  storefront       Storefront                    @relation(fields: [storefrontId], references: [internalStorefrontId], onDelete: Restrict)
  product          Product                       @relation(fields: [internalProductId], references: [internalProductId], onDelete: Restrict)
  seller           MarketplaceParticipant        @relation("OrderSeller", fields: [sellerParticipantId], references: [id], onDelete: Restrict)
  promoter         MarketplaceParticipant?       @relation("OrderPromoter", fields: [promoterParticipantId], references: [id], onDelete: Restrict)

  /// The economics of this sale, when it completed. At most one (0M.T1).
  ///
  /// The foreign key lives on the SNAPSHOT, not here, and the relation is named
  /// so it stays that way: an Order exists before any economics do, so a column
  /// on this side would be a nullable pointer that is null for the entire window
  /// in which the payment is actually running.
  economicSnapshot  TransactionEconomicSnapshot? @relation("OrderEconomics")
  purchaseEvidence  PurchaseEvidence?
  reviewAuthorities ReviewSubmissionAuthority[]

  /// Why this Order was charged the tax it was charged (Phase 1.2).
  taxEvidence        OrderTaxEvidence?
  /// What was given back, if anything (Phase 1.2). New evidence, not an edit.
  reversals          TransactionReversal[]
  orderBuyerSnapshot OrderBuyerSnapshot?

  @@index([buyerAccountId, placedAt])
  @@index([sellerParticipantId, lifecycle])
  @@index([promoterParticipantId, lifecycle])
  @@index([internalListingId, placedAt])
  @@index([lifecycle, placedAt])
  @@index([listingSourceRecordId, listingSourceRecordVersion])
  @@index([policyId, policyVersion])
}

/// What Monacado owes one party for one completed sale (0M.9).
///
/// AN ACCOUNTING CLAIM, NEVER A PAYMENT. There is no transfer, batch, schedule,
/// bank detail, provider payout identifier, or reserve column. `PAID` records
/// that Monacado has settled the claim; it does not settle it. Payout EXECUTION
/// is not implemented in this phase.
///
/// The amount is COPIED FROM THE SNAPSHOT, never recomputed: a seller's claim is
/// exactly `sellerProceedsMinorUnits`, a promoter's exactly
/// `promoterNetProceedsMinorUnits` — spread PLUS seller-funded commission, since
/// taking only the spread would silently withhold what the seller funded.
///
/// A seller-direct sale creates ONE row; a promoted sale creates TWO. Not "two,
/// one of them zero" — a seller selling their own product has no promoter
/// counterparty, and a zero row would describe one who earned nothing.
model ProceedsObligation {
  /// Opaque identity (mon:pobl:<opaque>). Distinct from mon:nobl:, which names
  /// an obligation to TELL someone something. Money owed and a notice owed are
  /// different obligations and never share an identifier space.
  id String @id @db.VarChar(191)

  /// The sale this claim arises from. The economics live there, not here.
  snapshotId String @db.VarChar(191)

  participantId String @db.VarChar(191)
  /// SELLER | PROMOTER. Monacado is deliberately not a member: its retained
  /// amount is what it KEPT, not something it owes itself.
  party         String @db.VarChar(16)

  /// Copied from the snapshot, never recalculated.
  amountMinorUnits BigInt
  currency         String @db.VarChar(3)

  /// PENDING | ELIGIBLE | PAID. Forward-only; PAID is terminal. What MOVES an
  /// obligation to ELIGIBLE is not decided here — funds settlement is 0M.T1,
  /// return windows are unbuilt, and payout holds are explicitly 0M.R2.
  state String @db.VarChar(16)

  /// When the claim arose — the instant of sale. Supplied, never a clock read.
  accruedAt        DateTime  @db.DateTime(3)
  becameEligibleAt DateTime? @db.DateTime(3)
  paidAt           DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: an obligation is a financial claim. Neither the sale beneath it
  // nor the party it is owed to may be deleted.
  snapshot    TransactionEconomicSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  participant MarketplaceParticipant      @relation(fields: [participantId], references: [id], onDelete: Restrict)

  /// ONE obligation per party per sale, enforced by the database rather than by
  /// a service remembering. Paying a party twice for one sale is the failure
  /// this exists to prevent.
  @@unique([snapshotId, party])
  @@index([participantId, state])
  @@index([state, accruedAt])
}

/// Monacado's PRIVATE record that one buyer transacted for one Product (0M.9).
///
/// Created only by a completed sale, one per Order. Referenced by id and NEVER
/// published (ADR §11.10) — it is the provenance behind a review, not content.
///
/// It names what a later review needs to know — which Product, and which seller
/// — and NOTHING about the person. There is deliberately no guest identifier: a
/// stable per-guest identifier would be the tracking key this design exists
/// without. A guest reaches their evidence through their Order, which they reach
/// with their claim code.
model PurchaseEvidence {
  /// Opaque identity (mon:pvev:<opaque>).
  id String @id @db.VarChar(191)

  /// One per Order.
  orderId String @unique @db.VarChar(191)

  /// NONE | UNVERIFIED | VERIFIED. Always VERIFIED here: a completed sale is
  /// exactly what verification means. 0M.1 requires VERIFIED for EVERY review,
  /// guest or account holder — authority derives from a purchase, not a login.
  purchaseProvenance String @db.VarChar(16)
  /// ACCOUNT_BUYER | GUEST_BUYER, carried from the Order.
  submitter          String @db.VarChar(16)

  /// The two reviewable subjects.
  internalProductId   String @db.VarChar(191)
  sellerParticipantId String @db.VarChar(191)

  /// The instant of the completed sale. Supplied, never a clock read.
  establishedAt DateTime @db.DateTime(3)
  createdAt     DateTime @default(now()) @db.DateTime(3)

  // RESTRICT: evidence supports a published review's authority. Nothing beneath
  // it may be deleted while it stands.
  order   Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product                @relation(fields: [internalProductId], references: [internalProductId], onDelete: Restrict)
  seller  MarketplaceParticipant @relation(fields: [sellerParticipantId], references: [id], onDelete: Restrict)

  authorities ReviewSubmissionAuthority[]

  @@index([internalProductId])
  @@index([sellerParticipantId])
}

/// The stored grant ADR §11.6 requires before Monacado publishes a review (0M.9).
///
/// Every column maps onto 0M.1's committed `ReviewSubmissionAuthorityView`, so a
/// persisted row feeds `evaluateReviewCapsuleAuthority` unchanged and this phase
/// adds NO second authority evaluator. `orderId` and `purchaseEvidenceId` are
/// storage lineage and are deliberately ABSENT from that view: an authority
/// decision has no business knowing an order id, and a view carrying one could
/// leak it into a capsule projection.
///
/// NO REVIEW CONTENT. There is no column for text, a rating, a title, a photo, or
/// a moderation decision, and no capsule is projected or published here. This
/// phase establishes WHO MAY WRITE; the writing is a later phase.
model ReviewSubmissionAuthority {
  /// Opaque identity (mon:rauth:<opaque>).
  id String @id @db.VarChar(191)

  /// The submission this authority is for (mon:rsub:<opaque>). Minted with the
  /// authority because 0M.1 binds them one-to-one: the submission IS the grant.
  reviewSubmissionId String @unique @db.VarChar(191)

  /// Storage lineage. Not part of the authority view.
  orderId            String @db.VarChar(191)
  purchaseEvidenceId String @db.VarChar(191)

  /// PRODUCT_REVIEW | SELLER_REVIEW. Two separate capsule authorities, never one
  /// "review" capsule with a type field (0M.1).
  reviewKind       String @db.VarChar(24)
  /// The Product id or the seller participant id — the node the review is about.
  reviewSubjectRef String @db.VarChar(191)

  /// ACCOUNT_BUYER | GUEST_BUYER. A guest MAY review: 0M.1 is explicit that a
  /// guest is "a real, supported case… and is not an account in disguise".
  submitter          String @db.VarChar(16)
  purchaseProvenance String @db.VarChar(16)

  /// SUBMITTED | EDITED | WITHDRAWN — the lifecycle that decides which capsule
  /// actions are authorized (0M.1's action table).
  submissionState String @db.VarChar(16)
  /// ACTIVE | INVALIDATED. INVALIDATED still permits REVOKE, so a review
  /// Monacado has decided must come down stays retractable.
  status          String @db.VarChar(16)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  // RESTRICT: an authority is the evidence a publication rested on.
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  purchaseEvidence PurchaseEvidence @relation(fields: [purchaseEvidenceId], references: [id], onDelete: Restrict)

  /// ONE authority per governed subject per Order. Buying once does not license
  /// writing repeatedly.
  @@unique([orderId, reviewKind])
  @@index([reviewKind, reviewSubjectRef])
  @@index([purchaseEvidenceId])
}

/// One governed commerce-approval decision (0M.9).
///
/// Monacado's determination that a participant may TRANSACT — the go-live
/// approval 0M.3A defined as "a supplied decision input", "Monacado's opinion
/// about a participant, not a fact about a shop", and deliberately refused to
/// store on the Storefront because "storing it would put the approver's decision
/// inside the approved thing".
///
/// That ruling is honoured, not overturned: the decision lives HERE, against the
/// participant it is about. There is deliberately NO storefrontId column. What
/// 0M.3A left open was where the supplied value comes from, and before 0M.9 the
/// answer was "a caller" — tolerable while nothing could be bought, and not
/// tolerable once a buyer-active Listing means real money moves.
///
/// ABSENCE MEANS NOT_APPROVED. No row is the default and the default is the safe
/// one: nothing needs seeding, no migration grants anyone clearance, and a
/// participant nobody has assessed cannot sell.
///
/// HISTORY IS NEVER REWRITTEN. A new decision supersedes the previous one and is
/// a new row; withdrawing approval records a withdrawal rather than editing the
/// grant that stood. Only `supersededAt` and the current marker are ever updated.
///
/// There is no risk score, reserve, cap, velocity window, payout hold, provider
/// message, underwriting document, or free-text note column — 0M.R2 owns the
/// first group and the rest is private operational data a governance record has
/// no reason to carry.
// ─────────────────────────────────────────────────────────────────────────────
// Pre-live commerce controls (Phase 1.2).
//
// The minimum persistence three controls need before live money can EVER be
// enabled. Every table here is additive; nothing existing is altered, and in
// particular TransactionEconomicSnapshot gains no column and no update path.
// ─────────────────────────────────────────────────────────────────────────────

/// WHO bought one Order — private transactional data (Phase 1.2 correction).
///
/// Account creation stays optional; COMPLETING A PURCHASE IS NOT ANONYMOUS. A
/// merchant of record cannot determine tax jurisdiction, answer a support
/// question, or ship anything to a buyer it knows nothing about.
///
/// This narrowly reverses 0M.9's blanket prohibition on persisting buyer contact
/// and address. That instinct was right for a phase that could not charge anyone
/// and is wrong for one that can. Everything in NEVER_ON_BUYER_SNAPSHOT stays
/// forbidden — card data belongs at the processor, identity dossiers nowhere.
///
/// NEVER_ON_ORDER STILL HOLDS LITERALLY: the Order row has no buyerEmail,
/// buyerName, or buyerAddress column and gains none. This is a SEPARATE table
/// joined one-to-one, so the commercial record and the personal record stay
/// separable — which is what lets one be retained, exported, or erased on a
/// different schedule from the other.
///
/// A GUEST IS STILL A GUEST. A guest Order carries a full snapshot without an
/// Account, a MarketplaceParticipant, or any published Node or capsule. The
/// snapshot is not an identity and is not reusable across orders.
///
/// PRIVATE, NEVER PUBLISHED. No capsule projects any field here (ADR §11.10).
model OrderBuyerSnapshot {
  /// Opaque identity (mon:obsn:<opaque>).
  id String @id @db.VarChar(191)

  /// One snapshot per Order. A second would be a second answer to "who bought
  /// this", and no reader could tell which was authoritative.
  orderId String @unique @db.VarChar(191)

  name  String @db.VarChar(200)
  email String @db.VarChar(320)

  // — Billing address. STRUCTURED, never a blob. —
  //
  // A free-form field would be unusable for the two things an address is for
  // here: deriving a tax jurisdiction, and handing a carrier something it can
  // deliver to. Both need the parts named, and parsing them back out of a blob
  // is a guess dressed as a field.
  //
  // line2/region/postalCode are NULLABLE because a great many valid addresses
  // have none of them, and a required empty string is a lie that validates.
  billingLine1       String  @db.VarChar(200)
  billingLine2       String? @db.VarChar(200)
  billingCity        String  @db.VarChar(120)
  billingRegion      String? @db.VarChar(8)
  billingPostalCode  String? @db.VarChar(32)
  /// ISO 3166-1 alpha-2. REQUIRED — the one field tax sourcing cannot proceed
  /// without.
  billingCountryCode String  @db.Char(2)

  // — Shipping address. CONDITIONAL on what the basket needs delivered. —
  //
  // Required when ANY purchased Product has deliveryMode PHYSICAL; absent for an
  // all-digital basket, which is never asked for one. The decision comes from
  // Product.factDeliveryMode — an explicit authoritative fact — and never from
  // free-form metadata.
  //
  // NULL therefore means "this basket needed no delivery address", which is a
  // fact worth being able to read back, not a gap.
  //
  // line2/region/postalCode stay nullable for the same reason they do on
  // billing — a great many valid addresses have none of them.
  shippingLine1       String? @db.VarChar(200)
  shippingLine2       String? @db.VarChar(200)
  shippingCity        String? @db.VarChar(120)
  shippingRegion      String? @db.VarChar(8)
  shippingPostalCode  String? @db.VarChar(32)
  shippingCountryCode String? @db.Char(2)

  /// DERIVED from the billing address at capture and stored beside it rather
  /// than recomputed on read. A deliberate duplication: the jurisdiction a tax
  /// amount was actually sourced under must stay answerable even if the
  /// derivation rule changes, and re-deriving it years later would answer a
  /// different question. NEVER derived from an IP address.
  taxCountryCode String  @db.Char(2)
  taxRegionCode  String? @db.VarChar(8)

  /// BUYER_SUPPLIED (typed into Monacado's checkout, good enough to price tax on
  /// because tax must be computed BEFORE a charge) | PROVIDER_CONFIRMED (read
  /// back from the completed Checkout Session — THE IDENTITY THE PAYMENT ACTUALLY
  /// AUTHORIZED, which supersedes anything a browser said and is never
  /// overwritten by later buyer-supplied data).
  detailSource String @db.VarChar(24)

  capturedAt DateTime @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  // RESTRICT: a snapshot is the record of who a commercial transaction was with.
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  taxEvidence OrderTaxEvidence[]

  @@index([email])
  @@index([taxCountryCode, taxRegionCode])
  @@index([detailSource])
}

/// Why one Order was charged the tax it was charged (Phase 1.2).
///
/// The Order already stores the AMOUNT (`quotedTaxAmountMinorUnits`). This is the
/// WHY: which engine answered, under which calculation reference, on what basis,
/// with what treatment, at what instant. The amount is repeated deliberately and
/// is a CHECKED INVARIANT against the Order rather than a second answer — if the
/// two ever disagree, that is the fact worth surfacing.
///
/// THERE IS NO ADDRESS COLUMN. Monacado collects no buyer address (0M.9's
/// NEVER_ON_ORDER), so a real tax engine's destination requirement is an open
/// pre-live blocker rather than something quietly satisfied here.
///
/// Tax is NOT commercial revenue: it reaches the buyer's total and no commercial
/// basis, structurally, because no calculator in this repository accepts it.
model OrderTaxEvidence {
  /// Opaque identity (mon:taxe:<opaque>). Names the EVIDENCE, not the
  /// calculation — the engine's own reference is a separate external string.
  id String @id @db.VarChar(191)

  /// One evidence row per Order. A second would be a second explanation of one
  /// charged amount, and no reader could tell which was authoritative.
  orderId String @unique @db.VarChar(191)

  /// TEST_ZERO_RATE | TEST_FLAT_RATE. Both are TEST adapters; no production tax
  /// vendor is named, configured, or installed.
  provider String @db.VarChar(32)

  /// The engine's own identifier for this calculation. Opaque: never parsed,
  /// never interpreted, and no decision is made from it. Kept so an auditor can
  /// reach the engine's reasoning without Monacado storing it.
  providerCalculationRef String @db.VarChar(191)

  currency              String @db.VarChar(3)
  /// What was charged. Checked equal to the Order's quoted tax before writing.
  taxAmountMinorUnits   BigInt
  /// What the tax was assessed ON — retail + shipping. Lets a later reader check
  /// the quote against the Order rather than trust they concerned one sale.
  basisAmountMinorUnits BigInt

  /// TAXABLE | EXEMPT | OUT_OF_SCOPE. Coarse on purpose: a finer vocabulary
  /// would be a claim about tax law Monacado is not the authority on.
  treatment String @db.VarChar(24)

  /// A bounded CODE (US-CA, GB) — the jurisdiction the amount was SOURCED under.
  /// Derived from the buyer snapshot's billing address, never from an IP.
  jurisdictionCode String? @db.VarChar(16)

  /// The buyer snapshot whose billing address produced that jurisdiction.
  ///
  /// The linkage that makes "what address was this tax calculated from" answerable
  /// years later. NULLABLE only because the column is additive over rows written
  /// before buyer snapshots existed; every row this phase writes sets it.
  buyerSnapshotId String? @db.VarChar(191)

  calculatedAt DateTime @db.DateTime(3)
  recordedAt   DateTime @db.DateTime(3)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  // RESTRICT: tax evidence explains a charge. Deleting the Order beneath it
  // would leave a charged amount nobody can account for.
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyerSnapshot OrderBuyerSnapshot? @relation(fields: [buyerSnapshotId], references: [id], onDelete: Restrict)

  @@index([provider, calculatedAt])
  @@index([treatment])
}

/// What was given back on a completed sale (Phase 1.2).
///
/// NEW EVIDENCE ABOUT a snapshot, never a correction OF one. 0M.T1 built
/// TransactionEconomicSnapshot with no update path — "economic facts are not
/// editable in place" — and this phase does not weaken that by one column. The
/// net position is snapshot MINUS reversal, DERIVED and stored nowhere.
///
/// FULL REVERSALS ONLY. A partial refund forces a decision about whose money
/// comes back first — Monacado's retention, the seller's proceeds, or the
/// promoter's spread — and every allocation rule is a commercial policy decision
/// with different winners. That ruling is MONACADO_MOR_BUSINESS_MODEL §I's, and
/// inventing one inside an accounting table would be inventing commercial terms.
///
/// AMOUNTS ARE POSITIVE MAGNITUDES. A signed column invites a reader to add it to
/// the snapshot and call the result truth, and the first sign error silently
/// doubles somebody's money. The `kind` carries direction; these carry size.
model TransactionReversal {
  /// Opaque identity (mon:txrev:<opaque>). Distinct from mon:txsnp: — sharing an
  /// identifier space would invite the in-place edit 0M.T1 forbids.
  id String @id @db.VarChar(191)

  /// The exact sale this reverses. UNIQUE: one reversal per snapshot, which is
  /// what makes a repeated reversal a refusal rather than a double credit.
  snapshotId String @unique @db.VarChar(191)

  /// Storage lineage, so an operator reaches the Order without a join.
  orderId String @db.VarChar(191)

  /// REFUND (Monacado returned funds) | CHARGEBACK (a bank took them). Different
  /// evidence and different disputes; 0M.T1 named this distinction as exactly
  /// what its settlement state deliberately did not carry.
  kind       String @db.VarChar(16)
  /// FULL. PARTIAL is explicitly deferred — see the model comment.
  scope      String @db.VarChar(16)
  /// Bounded Monacado classification. NEVER provider text or a dispute narrative.
  reasonCode String @db.VarChar(32)

  currency String @db.VarChar(3)

  // — What each party gives back. Mirrors the snapshot one-for-one, so a full
  //   reversal is checkable by equality rather than by interpretation. —
  reversedCommercialRetailAmountMinorUnits BigInt
  reversedTaxAmountMinorUnits              BigInt
  reversedShippingAmountMinorUnits         BigInt
  reversedOtherPassThroughAmountMinorUnits BigInt
  reversedMonacadoRetainedAmountMinorUnits BigInt
  reversedSellerProceedsMinorUnits         BigInt
  /// Promoted sales only. NULL on a seller-direct reversal, never zero — a zero
  /// would describe a promoter who gave back nothing rather than one who does
  /// not exist.
  reversedPromoterNetProceedsMinorUnits    BigInt?

  /// Provider evidence, on 0M.T1's terms. Both NULL until it exists.
  provider            String? @db.VarChar(32)
  providerReversalRef String? @db.VarChar(191)

  /// When the money actually moved back. Supplied, never a clock read.
  occurredAt DateTime @db.DateTime(3)
  recordedAt DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  // RESTRICT everywhere: a reversal is financial evidence. Nothing it binds to
  // may be deleted beneath it.
  snapshot TransactionEconomicSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  order    Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([kind, occurredAt])
  @@index([occurredAt])
}

/// Stable transaction-risk policy identity (Phase 1.2).
///
/// Deliberately NOT a CommercialPolicy. A commercial policy decides what Monacado
/// EARNS; a risk policy decides what Monacado PERMITS. Merging them would let a
/// change to one silently move the other.
model RiskPolicy {
  /// Opaque identity (mon:rpol:<opaque>). Distinct from mon:cpol:.
  id String @id @db.VarChar(191)

  /// Operator-facing label. Never a rule and never a threshold.
  label String @db.VarChar(120)

  createdAt DateTime @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  versions RiskPolicyVersionRow[]
}

/// One IMMUTABLE version of the risk controls (Phase 1.2).
///
/// Mirrors CommercialPolicyVersionRow exactly, and for the same reason: a
/// threshold hard-coded in source is a number that changes without a record of
/// who changed it or what an Order was evaluated under. A limit change is a NEW
/// ROW; no historical row is ever rewritten.
model RiskPolicyVersionRow {
  /// Surrogate key. The meaningful identity is (policyId, policyVersion).
  seq BigInt @id @default(autoincrement())

  policyId      String @db.VarChar(191)
  policyVersion String @db.VarChar(64)

  /// DRAFT | ACTIVE | RETIRED. RETIRED stays bindable by historical reference —
  /// a decision taken under it must remain explicable.
  status String @db.VarChar(16)

  // — Controls. Inputs only; nothing derived is stored. —
  currency                                 String  @db.VarChar(3)
  /// The largest COMMERCIAL RETAIL amount one Order may carry. Retail rather
  /// than buyer total, deliberately: tax and shipping are pass-through amounts
  /// Monacado neither earns nor sets, and letting them push an Order over a
  /// commercial limit would deny a sale for somebody else's rate.
  maxSingleOrderCommercialAmountMinorUnits BigInt
  /// Whether a seller must hold a current APPROVED commerce decision (0M.9).
  requireSellerCommerceApproval            Boolean
  /// Whether a seller's provider account must be ENABLED (0M.8) to sell.
  requireSellerPaymentReadiness            Boolean

  /// When this version's controls begin to apply. Supplied, never a clock read.
  effectiveFrom DateTime @db.DateTime(3)

  /// Who recorded it, as the durable internal Account id. Never an email.
  recordedByAccountId String   @db.VarChar(191)
  recordedAt          DateTime @db.DateTime(3)

  retiredAt          DateTime? @db.DateTime(3)
  retiredByAccountId String?   @db.VarChar(191)

  /// Set to `policyId` while ACTIVE and NULL otherwise, so the unique index
  /// enforces AT MOST ONE ACTIVE VERSION PER POLICY while permitting any number
  /// of DRAFT and RETIRED ones. MySQL has no partial indexes; this is the same
  /// technique CommercialPolicyVersionRow uses.
  activeMarker String? @db.VarChar(191)

  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  policy RiskPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([policyId, policyVersion])
  @@unique([activeMarker])
  @@index([policyId, status])
  @@index([effectiveFrom])
}

model ParticipantCommerceApproval {
  /// Opaque identity (mon:pcap:<opaque>). Operational only, never published.
  id String @id @db.VarChar(191)

  participantId String @db.VarChar(191)

  /// APPROVED | NOT_APPROVED — 0M.3A's committed GO_LIVE_APPROVAL_STATUSES,
  /// reused rather than restated so the stored decision and the value
  /// `isPubliclyAccessible` consumes can never come to mean different things.
  decision String @db.VarChar(16)

  /// Bounded classification, never free text and never private content.
  reasonCode String @db.VarChar(48)

  decidedAt DateTime @db.DateTime(3)

  /// Who decided, as the durable internal Account identity (0M.8's settled actor
  /// rule) — never an email address and never a display name. This is the SAME
  /// identity `participant:commerce-approve` was evaluated against, so the audit
  /// actor is by construction the authorized one.
  decidedByAccountId String @db.VarChar(191)

  /// Set when a later decision supersedes this one. NULL while it stands.
  supersededAt DateTime? @db.DateTime(3)

  createdAt DateTime @default(now()) @db.DateTime(3)

  /// Set to `participantId` while this decision is current and NULL once
  /// superseded, so the unique index enforces AT MOST ONE CURRENT DECISION PER
  /// PARTICIPANT while permitting any number of superseded ones. MySQL has no
  /// partial indexes; this is the same technique
  /// `ParticipantActivation.undecidedForParticipantId` uses.
  currentForParticipantId String? @unique @db.VarChar(191)

  // RESTRICT: an approval is the evidence behind every sale a participant made.
  // Deleting the participant beneath it must be refused, and superseding is a
  // state change rather than a delete, so history always survives.
  participant MarketplaceParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)

  @@index([participantId, decidedAt])
  @@index([decision, decidedAt])
}

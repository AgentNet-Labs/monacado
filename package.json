{
  "name": "monacado",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:validate": "tsx scripts/contracts-validate.ts",
    "contracts:export": "tsx scripts/contracts-export.ts",
    "contracts:demo": "tsx scripts/contracts-demo.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check": "tsx scripts/db-check.ts",
    "policy:bootstrap": "tsx scripts/bootstrap-marketplace-policy.ts",
    "policy:bootstrap:activate": "tsx scripts/bootstrap-marketplace-policy.ts --activate",
    "policy:bootstrap:inspect": "tsx scripts/bootstrap-marketplace-policy.ts --inspect",
    "tax:readiness": "tsx scripts/tax-readiness.ts",
    "tax:record:once": "tsx scripts/run-tax-transaction-recorder.ts",
    "tax:record:status": "tsx scripts/tax-recording-status.ts",
    "refund:process:once": "tsx scripts/run-refund-processor.ts",
    "refund:status": "tsx scripts/refund-status.ts",
    "dispute:status": "tsx scripts/dispute-status.ts",
    "worker:publication:once": "tsx scripts/run-publication-worker.ts",
    "email:dispatch:once": "tsx scripts/run-email-dispatcher.ts",
    "db:test": "RUN_DB_TESTS=1 vitest run --no-file-parallelism test/*.integration.test.ts",
    "postinstall": "prisma generate",
    "validate": "npm run lint && npm run typecheck && npm run contracts:validate && npm run test && npm run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
